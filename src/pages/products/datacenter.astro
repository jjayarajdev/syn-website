---
import Layout from '../../layouts/Layout.astro';

const products = [
  {
    name: 'Thermal Forecasting & Management',
    tagline: 'The Tesla Autopilot for Data Centers',
    description: 'Predictive thermal forecasting with LSTM models that predict temperature 30-60 minutes ahead. Real-time anomaly detection and energy optimization.',
    metrics: ['95% prediction accuracy', '30-60 min forecasts', '99.9% uptime'],
  },
  {
    name: 'Waste-Heat Recovery',
    tagline: 'Turn Digital Waste into Digital Gold',
    description: 'AI-optimized heat recovery using thermal gradient analysis. Sell recovered energy back to grid and generate carbon credits automatically.',
    metrics: ['$100-500K revenue', '20-30% carbon cut', '18-24 mo payback'],
  },
  {
    name: 'Thermal Digital Twin',
    tagline: 'Digital Twin for Data Centers',
    description: 'Real-time thermal state replication with what-if scenario testing. Predict impact of failures and optimize capacity planning risk-free.',
    metrics: ['Real-time sync', 'What-if sims', 'Failure prediction'],
  },
  {
    name: 'Carbon & ESG Reporting',
    tagline: 'Net-Zero Through AI',
    description: 'Real-time CO2 monitoring, renewable optimization, automated carbon credit management, and ESG compliance reporting.',
    metrics: ['ESG automation', 'Carbon trading', 'Net Zero tracking'],
  },
];

const results = [
  { value: '15%', label: 'Cooling Cost Reduction' },
  { value: '$2-5M', label: 'Annual Savings' },
  { value: '99.9%', label: 'Uptime Guarantee' },
  { value: '30%', label: 'Carbon Reduction' },
];

const forecasting = [
  { name: 'ARIMA + Kalman Filtering', desc: '74% better accuracy than linear regression. Advanced temperature prediction with real-time state estimation.' },
  { name: 'FFT Spectral Analysis', desc: 'Frequency-domain pattern recognition for power consumption. Detects cyclical patterns invisible to time-domain methods.' },
  { name: 'Holt-Winters Smoothing', desc: 'Triple exponential smoothing for PUE efficiency. Captures trend and seasonal components simultaneously.' },
  { name: 'Physics-Based Validation', desc: 'Thermodynamic constraints ensure every prediction is physically realistic. No hallucinated temperatures.' },
  { name: 'Ensemble Fusion', desc: 'Confidence-weighted integration of all algorithms. Each method votes — the ensemble delivers superior reliability.' },
];
---

<Layout title="Datacenter Thermal Intelligence | Syntegreti" description="AI thermal intelligence built on real supercomputer data. 95% prediction accuracy, 15% cooling cost reduction.">

  <!-- Hero -->
  <section class="relative pt-24 pb-10 overflow-hidden">
    <div class="absolute inset-0 grid-bg opacity-20"></div>
    <div class="absolute top-1/4 -right-32 h-96 w-96 rounded-full bg-accent/5 blur-[120px]"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-6">
      <div class="max-w-3xl" data-animate>
        <div class="mb-6 flex items-center gap-3">
          <span class="inline-flex items-center gap-2 rounded-full border border-accent/20 bg-accent/5 px-4 py-1.5 text-sm font-medium text-accent">Product</span>
          <span class="rounded-full border border-border px-3 py-1 text-xs text-text-muted">Datacenter Thermal Intelligence</span>
        </div>
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
          <span class="gradient-text">Datacenter Solutions</span>
        </h1>
        <p class="mt-2 font-mono text-lg text-text-muted">AI-powered thermal intelligence for data centers</p>
        <p class="mt-6 text-lg leading-relaxed text-text-secondary">
          The world's first AI thermal management system built on real supercomputer data. We transform cooling from reactive monitoring to predictive optimization — 95% accuracy with 30-60 minute forecasts.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/contact" class="inline-flex items-center gap-2 rounded-xl bg-accent px-7 py-3.5 text-sm font-semibold text-void transition-all hover:shadow-[0_0_30px_rgba(0,232,123,0.3)]">Schedule a Demo</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Results strip -->
  <section class="py-8">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid grid-cols-2 gap-4 lg:grid-cols-4" data-stagger>
        {results.map((r) => (
          <div class="glow-card-subtle p-6 text-center">
            <div class="text-3xl font-bold text-amber">{r.value}</div>
            <div class="mt-1 text-sm font-semibold text-text-primary">{r.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The opportunity -->
  <section class="py-10">
    <div class="mx-auto max-w-7xl px-6">
      <div class="glow-card-subtle p-10" data-animate>
        <span class="font-mono text-sm text-accent">// the_opportunity</span>
        <h2 class="mt-3 text-2xl font-bold">Data centers consume 3% of global electricity.</h2>
        <p class="mt-4 text-sm leading-relaxed text-text-secondary max-w-2xl">
          Current thermal management is reactive and costly — 15-30% energy waste. Traditional DCIM only monitors. We predict, analyze, auto-resolve, and optimize.
        </p>
        <div class="mt-6 font-mono text-xs text-text-muted">
          Traditional: Monitor → Alert → Manual Response<br />
          <span class="text-accent">Datacenter thermal intelligence: Predict → Analyze → Auto-Resolve → Optimize</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Ensemble Forecasting — redesigned as pillar grid -->
  <section class="py-10">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-8" data-animate>
        <span class="font-mono text-sm text-accent">// ensemble_ai</span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Multi-Algorithm Ensemble Forecasting</h2>
        <p class="mt-4 max-w-2xl text-text-secondary">Five forecasting methods fused into one prediction engine. Each has strengths — our ensemble captures them all.</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5" data-stagger>
        {forecasting.map((algo, i) => (
          <div class="glow-card-subtle p-6 flex flex-col">
            <div class="flex items-center justify-between mb-4">
              <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10">
                <span class="font-mono text-xs font-bold text-accent">{String(i + 1).padStart(2, '0')}</span>
              </div>
            </div>
            <h3 class="text-sm font-bold text-text-primary">{algo.name}</h3>
            <p class="mt-2 text-xs leading-relaxed text-text-secondary flex-1">{algo.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Platform Products — glow cards -->
  <section class="py-10">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-8" data-animate>
        <span class="font-mono text-sm text-accent">// platform_suite</span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Platform Products</h2>
      </div>
      <div class="grid gap-4 md:grid-cols-2" data-stagger>
        {products.map((product) => (
          <div class="glow-card-subtle p-8">
            <h3 class="text-xl font-bold text-text-primary">{product.name}</h3>
            <p class="mt-1 font-mono text-xs text-accent">{product.tagline}</p>
            <p class="mt-4 text-sm leading-relaxed text-text-secondary">{product.description}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {product.metrics.map((m) => (
                <span class="rounded-md bg-amber/10 px-2.5 py-1 text-xs text-amber">{m}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-10">
    <div class="mx-auto max-w-7xl px-6">
      <div class="glow-card-subtle p-12 text-center" data-animate>
        <h2 class="text-3xl font-bold tracking-tight">
          15% cooling cost reduction.<br />
          <span class="gradient-text">Measured in weeks, not months.</span>
        </h2>
        <a href="/contact" class="mt-8 inline-flex items-center gap-2 rounded-xl bg-accent px-8 py-4 text-sm font-semibold text-void transition-all hover:shadow-[0_0_30px_rgba(0,232,123,0.3)]">Schedule a Demo</a>
      </div>
    </div>
  </section>
</Layout>
