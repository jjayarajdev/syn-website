---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';

// One card shape for every platform on the page.
// name    — the product name (heading)
// tagline — one line under the name
// layer   — optional spine label (GOVERN / BUILD / VERIFY)
// facts   — three proof points

const flagships = [
  {
    id: 'contract-intelligence',
    icon: 'file-text',
    name: 'Contract Intelligence',
    tagline: 'Your contracts, read. Your vendor relationships, governed.',
    href: '/products/contract-intelligence',
    description:
      'AI-native contract lifecycle management that goes beyond the repository. Nine specialised agents extract terms, score risk and track obligations, renewals and SLAs — and a relationship-governance layer scores every vendor relationship against the KPIs you agree.',
    facts: [
      'Nine specialised agents for extraction, risk and obligations',
      'Vendor KPI scoring beyond the contract text',
      'Multi-tenant, semantic search, every agent run audit-traced',
    ],
  },
  {
    id: 'business-operations',
    icon: 'layout-grid',
    name: 'Business Operations',
    tagline: 'One platform for how a business actually runs.',
    href: '/products/business-operations',
    description:
      'Sales, Marketing, HR, Finance, Projects, Recruitment and ITSM — seven modules in one multi-tenant SaaS. The built-in assistant carries 160 AI actions across four graduated autonomy levels, from suggest-only to fully autonomous, so AI takes on exactly as much as you allow.',
    facts: [
      'Seven business modules, one data model',
      '160 AI actions across four autonomy levels',
      'Autonomous sales agent under your policy, MCP server built in',
    ],
  },
];

const spine = [
  {
    id: 'ai-governance',
    layer: 'GOVERN',
    icon: 'shield-check',
    name: 'AI Governance',
    tagline: 'Govern every AI call your enterprise makes.',
    href: '/products/ai-governance',
    description:
      'A forward proxy that intercepts and governs all LLM traffic. Policy enforcement per team and per model, local ML-based DLP that catches PII before it leaves your network, and a complete audit log of every AI interaction.',
    facts: [
      'Local ML DLP — no data leaves your network',
      'Policy enforcement per team and per model',
      'Full audit log, time-series analytics, live dashboard',
    ],
  },
  {
    id: 'ai-sdlc',
    layer: 'BUILD',
    icon: 'git-branch',
    name: 'AI-Assisted SDLC',
    tagline: 'Build software with AI and keep the audit trail.',
    href: '/products/ai-sdlc',
    description:
      'Structured AI workflows for the entire SDLC. Five roles, one thread of context, and a full compliance audit trail for every AI-generated artifact. Exports to nine AI coding tools.',
    facts: [
      'Five role-based phases with context threading',
      'VS Code, Desktop, CLI and MCP server',
      'Audit trail from code to prompt to requirement',
    ],
  },
  {
    id: 'testing-suite',
    layer: 'VERIFY',
    icon: 'flask-conical',
    name: 'AI Testing Suite',
    tagline: 'Author in English. Run against reality. Verify the data.',
    href: '/products/testing-suite',
    description:
      'AI-native end-to-end test automation. Tests are authored in plain English, calibrated against the live site and self-heal at run time — and a data validation agent reconciles what the screen shows with the row in the database.',
    facts: [
      'Plain-English authoring and live-app discovery',
      'Self-healing selectors, deterministic LLM-free runtime',
      'Database and API validation behind every screen',
    ],
  },
];

const industry = [
  {
    id: 'regulatory-reporting',
    icon: 'landmark',
    name: 'Regulatory Reporting',
    tagline: 'For US P&C insurance carriers.',
    href: '/products/regulatory-reporting',
    description:
      'Regulation PDFs become a knowledge graph, and the knowledge graph becomes executable filing schemas — with carrier data validation and compliance sign-off. Texas and Florida statistical filings already built, running on Snowflake, DuckDB or Databricks.',
    facts: [
      'Regulation to knowledge graph to executable schema',
      'Texas and Florida filings built today',
      'Runs on Snowflake, DuckDB or Databricks',
    ],
  },
  {
    id: 'datacenter',
    icon: 'server',
    name: 'Datacenter Solutions',
    tagline: 'For data center operators.',
    href: '/products/datacenter',
    description:
      'AI thermal management built on real exascale supercomputer operational data. An ensemble of five forecasting models predicts temperature 30-60 minutes ahead at 95% accuracy — with a thermal digital twin, waste-heat recovery and carbon reporting built in.',
    facts: [
      '95% forecast accuracy, 30-60 minute horizon',
      '15% cooling cut, $2-5M saved per facility per year',
      'Digital twin, heat recovery and ESG reporting',
    ],
  },
];
---

<Layout title="Platforms — Syntegreti" description="Seven working platforms built in-house by one team: Contract Intelligence and Business Operations to run the business; AI Governance, AI-Assisted SDLC and AI Testing Suite to adopt AI safely; Regulatory Reporting and Datacenter Solutions built for your industry.">
  <section class="relative pt-24 pb-10">
    <div class="absolute inset-0 grid-bg opacity-20"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-6">

      <!-- ============ HERO ============ -->
      <div class="max-w-3xl mb-14" data-animate>
        <span class="font-mono text-sm text-accent">// our_platforms</span>
        <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
          Seven platforms.<br />
          <span class="gradient-text">One team. One spine.</span>
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-text-secondary">
          Two platforms run the business. Three govern how you adopt AI —
          govern, build, verify. Two are built for a specific industry.
          Every one is working software, built in-house, deployed inside your
          environment, with a pilot available today.
        </p>
      </div>

      <!-- ============ 1. RUN THE BUSINESS ============ -->
      <div class="mb-8" data-animate>
        <span class="font-mono text-sm text-accent">// 01_run_the_business</span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight">Run the business</h2>
        <p class="mt-3 max-w-2xl text-text-secondary">
          The two flagship platforms — one for the contracts your business signs,
          one for the operations it runs every day.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 mb-16" data-stagger>
        {flagships.map((p) => (
          <a href={p.href} id={p.id} class="group glow-card-subtle p-8 flex flex-col scroll-mt-28">
            <div class="flex items-center justify-between mb-5">
              <span class="inline-flex h-10 w-10 items-center justify-center border border-border bg-deep/30"><Icon name={p.icon} size={20} class="text-accent" /></span>
              <span class="rounded-full border border-accent/20 bg-accent/5 px-3 py-1 text-[12px] font-semibold uppercase tracking-wider text-accent">Platform</span>
            </div>
            <h3 class="text-2xl font-bold text-accent">{p.name}</h3>
            <p class="mt-1 font-mono text-[13px] text-text-muted">{p.tagline}</p>
            <p class="mt-4 text-sm leading-relaxed text-text-secondary flex-1">{p.description}</p>
            <ul class="mt-5 space-y-1.5 border-t border-border/50 pt-4">
              {p.facts.map((fact) => (
                <li class="flex items-start gap-2 text-[13px] text-text-secondary">
                  <span class="mt-0.5 text-accent">▸</span>
                  {fact}
                </li>
              ))}
            </ul>
            <div class="mt-5 flex items-center gap-1 text-xs font-medium text-accent opacity-0 transition-opacity group-hover:opacity-100">
              Explore the platform →
            </div>
          </a>
        ))}
      </div>

      <!-- ============ 2. ADOPT AI SAFELY ============ -->
      <div class="mb-8" data-animate>
        <span class="font-mono text-sm text-accent">// 02_adopt_ai_safely</span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight">Adopt AI safely</h2>
        <p class="mt-3 max-w-2xl text-text-secondary">
          The AI spine. How you govern AI, how you build with it, and how you
          verify what you ship — the same three layers every platform we make
          runs on.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-3 mb-16" data-stagger>
        {spine.map((p) => (
          <a href={p.href} id={p.id} class="group glow-card-subtle p-7 flex flex-col scroll-mt-28">
            <div class="flex items-center justify-between mb-5">
              <span class="font-mono text-[12px] tracking-widest text-accent"><Icon name={p.icon} size={14} class="inline -mt-0.5" /> {p.layer}</span>
              <span class="rounded-full border border-accent/20 bg-accent/5 px-3 py-1 text-[12px] font-semibold uppercase tracking-wider text-accent">Platform</span>
            </div>
            <h3 class="text-xl font-bold text-accent">{p.name}</h3>
            <p class="mt-1 font-mono text-[13px] text-text-muted">{p.tagline}</p>
            <p class="mt-4 text-sm leading-relaxed text-text-secondary flex-1">{p.description}</p>
            <ul class="mt-5 space-y-1.5 border-t border-border/50 pt-4">
              {p.facts.map((fact) => (
                <li class="flex items-start gap-2 text-[13px] text-text-secondary">
                  <span class="mt-0.5 text-accent">▸</span>
                  {fact}
                </li>
              ))}
            </ul>
            <div class="mt-5 flex items-center gap-1 text-xs font-medium text-accent opacity-0 transition-opacity group-hover:opacity-100">
              Explore the platform →
            </div>
          </a>
        ))}
      </div>

      <!-- ============ 3. BUILT FOR YOUR INDUSTRY ============ -->
      <div class="mb-8" data-animate>
        <span class="font-mono text-sm text-accent">// 03_built_for_your_industry</span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight">Built for your industry</h2>
        <p class="mt-3 max-w-2xl text-text-secondary">
          Two platforms that solve one hard, specific problem for one kind of
          buyer — on the same spine as everything above.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 mb-10" data-stagger>
        {industry.map((p) => (
          <a href={p.href} id={p.id} class="group glow-card-subtle p-7 flex flex-col scroll-mt-28">
            <div class="flex items-center justify-between mb-5">
              <span class="inline-flex h-10 w-10 items-center justify-center border border-border bg-deep/30"><Icon name={p.icon} size={20} class="text-accent" /></span>
              <span class="rounded-full border border-accent/20 bg-accent/5 px-3 py-1 text-[12px] font-semibold uppercase tracking-wider text-accent">Platform</span>
            </div>
            <h3 class="text-xl font-bold text-accent">{p.name}</h3>
            <p class="mt-1 font-mono text-[13px] text-text-muted">{p.tagline}</p>
            <p class="mt-4 text-sm leading-relaxed text-text-secondary flex-1">{p.description}</p>
            <ul class="mt-5 space-y-1.5 border-t border-border/50 pt-4">
              {p.facts.map((fact) => (
                <li class="flex items-start gap-2 text-[13px] text-text-secondary">
                  <span class="mt-0.5 text-accent">▸</span>
                  {fact}
                </li>
              ))}
            </ul>
            <div class="mt-5 flex items-center gap-1 text-xs font-medium text-accent opacity-0 transition-opacity group-hover:opacity-100">
              Explore the platform →
            </div>
          </a>
        ))}
      </div>

      <!-- ============ CTA ============ -->
      <div class="mt-10 rounded-2xl border border-border/50 bg-deep/50 p-8 text-center" data-animate>
        <h2 class="text-2xl font-bold tracking-tight">
          Every platform here has a <span class="gradient-text">pilot</span>.
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-sm text-text-secondary">
          Pick the one closest to your problem. We scope the pilot to your
          systems, run it inside your environment, and you judge it on your own
          data.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-4">
          <a href="/contact" class="inline-flex items-center gap-2 rounded-xl bg-accent px-7 py-3.5 text-sm font-semibold text-void transition-all hover:bg-accent-glow hover:shadow-[0_0_30px_rgba(0,232,123,0.3)]">
            Request a Pilot
          </a>
          <a href="/case-studies" class="inline-flex items-center gap-2 rounded-xl border border-border px-7 py-3.5 text-sm font-medium text-text-secondary transition-all hover:border-border-light hover:bg-elevated">
            See what's already in production
          </a>
        </div>
      </div>

    </div>
  </section>
</Layout>
