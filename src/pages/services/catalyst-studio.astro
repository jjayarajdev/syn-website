---
import Layout from '../../layouts/Layout.astro';

const phases = [
  {
    num: '01',
    name: 'Ideation',
    duration: 'Week 1',
    details: [
      'Stakeholder alignment workshops',
      'Business benefits identification',
      'Use case prioritization',
      'Success criteria definition',
    ],
  },
  {
    num: '02',
    name: 'Tech Stack',
    duration: 'Week 2',
    details: [
      'Architecture finalization',
      'Model selection & benchmarking',
      'Developer environment setup',
      'Data pipeline design',
    ],
  },
  {
    num: '03',
    name: 'Rapid Build',
    duration: 'Weeks 2-3',
    details: [
      'Accelerated prototyping with our toolkit',
      'Integration with your systems',
      'Iterative demos with stakeholders',
      'Performance optimization',
    ],
  },
  {
    num: '04',
    name: 'Toll Gate',
    duration: 'Week 4',
    details: [
      'Go / No-Go decision point',
      'Production roadmap if Go',
      'Full documentation & handover',
      'ROI analysis & scaling plan',
    ],
  },
];
---

<Layout title="Catalyst Studio — AI MVP Factory | Syntegreti" description="Fixed-scope, fixed-fee 4-week AI sprint. One problem, 2-3 systems, working proof with real metrics. Book a sprint.">

  <!-- Hero -->
  <section class="relative pt-24 pb-10 overflow-hidden">
    <div class="absolute inset-0 grid-bg opacity-20"></div>
    <div class="absolute top-1/3 -left-32 h-96 w-96 rounded-full bg-accent/5 blur-[120px]"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-6">
      <div class="max-w-3xl" data-animate>
        <div class="mb-6 flex items-center gap-3">
          <span class="inline-flex items-center gap-2 rounded-full border border-accent/20 bg-accent/5 px-4 py-1.5 text-sm font-medium text-accent">
            Service
          </span>
          <span class="rounded-full border border-border px-3 py-1 text-xs text-text-muted">Every engagement starts here</span>
        </div>

        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
          <span class="gradient-text">Catalyst Studio</span>
        </h1>
        <p class="mt-2 font-mono text-lg text-text-muted">
          Our MVP Factory
        </p>
        <p class="mt-6 text-lg leading-relaxed text-text-secondary">
          Fixed-scope, fixed-fee, 4 weeks. One problem, two to three systems,
          a working proof with real metrics — and an honest Go/No-Go recommendation
          before you commit to anything bigger.
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/contact" class="group inline-flex items-center gap-2 rounded-xl bg-accent px-7 py-3.5 text-sm font-semibold text-void transition-all hover:bg-accent-glow hover:shadow-[0_0_30px_rgba(0,232,123,0.3)]">
            Book a 4-Week Sprint
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- What you sign / What you get — synced with homepage -->
  <section class="py-8">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid gap-8 lg:grid-cols-2" data-stagger>

        <!-- What you sign -->
        <div class="glow-card-subtle p-8">
          <h2 class="text-xl font-bold text-text-primary mb-6">What you sign.</h2>
          <div class="space-y-5">
            {[
              { title: 'Fixed-scope, fixed-fee', desc: 'No open-ended engagements. One problem, one price, one timeline.' },
              { title: '1 problem, 2-3 systems, 4 weeks', desc: 'Scoped tight enough to prove feasibility, broad enough to be meaningful.' },
              { title: 'Co-owned by your lead + our architect', desc: 'Your product/IT lead works directly with our principal engineer. No telephone game.' },
              { title: 'Go/No-Go at week 4', desc: 'Working proof, real metrics, honest recommendation. If it won\'t work, we tell you.' },
            ].map((item) => (
              <div class="flex items-start gap-3">
                <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-accent/10">
                  <svg class="h-4 w-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-sm font-bold text-text-primary">{item.title}</h4>
                  <p class="text-xs text-text-secondary">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- What you get -->
        <div class="glow-card-subtle p-8">
          <h2 class="text-xl font-bold text-text-primary mb-6">What you get.</h2>
          <div class="space-y-3">
            {[
              'Working prototype connected to your actual systems',
              'Architecture document and technical roadmap',
              'Performance benchmarks and accuracy metrics',
              'Go/No-Go recommendation backed by evidence',
              'Production scaling plan with timeline and cost',
              'Full source code, documentation, and handover',
            ].map((item) => (
              <div class="flex items-start gap-3 rounded-lg border border-border/50 bg-deep/50 px-4 py-3">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-sm text-text-secondary">{item}</span>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 4-Week Timeline -->
  <section class="py-8">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-8" data-animate>
        <span class="font-mono text-sm text-accent">// the_sprint</span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          4-Week Sprint
        </h2>
      </div>

      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4" data-stagger>
        {phases.map((phase) => (
          <div class="glow-card-subtle p-6">
            <div class="flex items-center gap-3 mb-4">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent/10">
                <span class="font-mono text-sm font-bold text-accent">{phase.num}</span>
              </div>
              <div>
                <h3 class="text-sm font-bold text-text-primary">{phase.name}</h3>
                <span class="font-mono text-xs text-text-muted">{phase.duration}</span>
              </div>
            </div>
            <ul class="space-y-2">
              {phase.details.map((detail) => (
                <li class="flex items-start gap-2 text-xs text-text-secondary">
                  <svg class="mt-0.5 h-3 w-3 shrink-0 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {detail}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What we've built with it — replaces generic capabilities -->
  <section class="py-8">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-8" data-animate>
        <span class="font-mono text-sm text-accent">// built_with_catalyst</span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          What we've built with it.
        </h2>
        <p class="mt-4 max-w-2xl text-text-secondary">
          These aren't hypothetical capabilities. These are products and deployments
          that came out of Catalyst Studio sprints.
        </p>
      </div>

      <div class="space-y-4" data-stagger>
        <!-- AI-assisted SDLC platform -->
        <div class="glow-card-subtle p-8">
          <div class="grid gap-6 md:grid-cols-3 md:items-center">
            <div class="md:col-span-2">
              <div class="flex items-center gap-3 mb-2">
                <h3 class="text-lg font-bold text-accent">AI-Assisted SDLC Platform</h3>
                <span class="rounded-full bg-accent/10 px-2.5 py-0.5 text-[12px] text-accent">Product</span>
              </div>
              <p class="text-sm text-text-secondary">
                AI-guided SDLC workflows with structured questionnaires, context threading,
                organizational learning via DSPy, and compliance audit trails via Langfuse.
                Started as a Catalyst sprint — now a full product.
              </p>
            </div>
            <div class="flex flex-wrap gap-2">
              <span class="rounded-md bg-accent/10 px-2.5 py-1 text-xs text-accent">LLM Orchestration</span>
              <span class="rounded-md bg-accent/10 px-2.5 py-1 text-xs text-accent">DSPy Optimization</span>
              <span class="rounded-md bg-accent/10 px-2.5 py-1 text-xs text-accent">Langfuse Tracing</span>
            </div>
          </div>
        </div>

        <!-- Enterprise agents -->
        <div class="glow-card-subtle p-8">
          <div class="grid gap-6 md:grid-cols-3 md:items-center">
            <div class="md:col-span-2">
              <div class="flex items-center gap-3 mb-2">
                <h3 class="text-lg font-bold text-accent">Enterprise Agents</h3>
                <span class="rounded-full bg-accent/10 px-2.5 py-0.5 text-[12px] text-accent">Product</span>
              </div>
              <p class="text-sm text-text-secondary">
                Multi-agent orchestration across ServiceNow, Salesforce, and Snowflake.
                Enterprise Intelligence Agent, Support Deflection Agent, Global Mobility Agent —
                all prototyped in Catalyst sprints, now in production.
              </p>
            </div>
            <div class="flex flex-wrap gap-2">
              <span class="rounded-md bg-accent/10 px-2.5 py-1 text-xs text-accent">Agentic RAG</span>
              <span class="rounded-md bg-accent/10 px-2.5 py-1 text-xs text-accent">VoltAgent</span>
              <span class="rounded-md bg-accent/10 px-2.5 py-1 text-xs text-accent">Multi-Agent</span>
            </div>
          </div>
        </div>

        <!-- AI Scheduling -->
        <div class="glow-card-subtle p-8">
          <div class="grid gap-6 md:grid-cols-3 md:items-center">
            <div class="md:col-span-2">
              <div class="flex items-center gap-3 mb-2">
                <h3 class="text-lg font-bold text-text-primary">AI Scheduling Assistant</h3>
                <span class="rounded-full bg-elevated px-2.5 py-0.5 text-[12px] text-text-secondary">Client deployment</span>
              </div>
              <p class="text-sm text-text-secondary">
                Omni-channel voice + chat + SMS scheduling with weather-aware logic.
                Claude Sonnet 3.5, DSPy optimization, sub-2.5s voice latency.
                $80-120K annual savings.
              </p>
            </div>
            <div class="flex flex-wrap gap-2">
              <span class="rounded-md bg-elevated px-2.5 py-1 text-xs text-text-secondary">Claude 3.5</span>
              <span class="rounded-md bg-elevated px-2.5 py-1 text-xs text-text-secondary">Voice AI</span>
              <span class="rounded-md bg-elevated px-2.5 py-1 text-xs text-text-secondary">DSPy</span>
            </div>
          </div>
        </div>

        <!-- Datacenter thermal intelligence -->
        <div class="glow-card-subtle p-8">
          <div class="grid gap-6 md:grid-cols-3 md:items-center">
            <div class="md:col-span-2">
              <div class="flex items-center gap-3 mb-2">
                <h3 class="text-lg font-bold text-accent">Datacenter Thermal Intelligence</h3>
                <span class="rounded-full bg-accent/10 px-2.5 py-0.5 text-[12px] text-accent">Product</span>
              </div>
              <p class="text-sm text-text-secondary">
                Ensemble ML forecasting for data center thermal management. 5 algorithms
                fused into one prediction engine. Built on real exascale supercomputer data.
                95% accuracy, $2-5M annual savings.
              </p>
            </div>
            <div class="flex flex-wrap gap-2">
              <span class="rounded-md bg-accent/10 px-2.5 py-1 text-xs text-accent">Ensemble ML</span>
              <span class="rounded-md bg-accent/10 px-2.5 py-1 text-xs text-accent">Vision (YOLO)</span>
              <span class="rounded-md bg-accent/10 px-2.5 py-1 text-xs text-accent">Digital Twin</span>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-6 text-center" data-animate>
        <p class="text-sm text-text-muted">
          Every capability we claim is backed by something we actually built and shipped.
        </p>
      </div>
    </div>
  </section>

  <!-- Tech Stack -->
  <section class="py-8">
    <div class="mx-auto max-w-7xl px-6">
      <div class="glow-card-subtle p-8" data-animate>
        <span class="font-mono text-sm text-accent">// technology</span>
        <h2 class="mt-3 text-lg font-bold">Technology Stack</h2>
        <div class="mt-6 flex flex-wrap gap-2">
          {['Python', 'PyTorch', 'TensorFlow', 'LangChain', 'DSPy', 'MLflow', 'OpenAI', 'Claude', 'AWS Bedrock', 'Llama', 'Falcon', 'VoltAgent', 'Kubernetes', 'Docker', 'AWS', 'Azure', 'GCP', 'TypeScript', 'React', 'FastAPI'].map((item) => (
            <span class="rounded-md border border-border px-3 py-1.5 font-mono text-xs text-text-secondary hover:border-accent/30 hover:text-accent transition-colors">{item}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-8">
    <div class="mx-auto max-w-7xl px-6">
      <div class="glow-card-subtle p-12 text-center" data-animate>
        <h2 class="text-3xl font-bold tracking-tight">
          4 weeks. Zero guesswork.<br />
          <span class="gradient-text">Prove it before you scale it.</span>
        </h2>
        <p class="mx-auto mt-4 max-w-lg text-text-secondary">
          Tell us your AI challenge. We'll tell you if it's solvable — and prove it.
        </p>
        <a href="/contact" class="mt-8 inline-flex items-center gap-2 rounded-xl bg-accent px-8 py-4 text-sm font-semibold text-void transition-all hover:bg-accent-glow hover:shadow-[0_0_30px_rgba(0,232,123,0.3)]">
          Book a 4-Week Sprint
        </a>
      </div>
    </div>
  </section>
</Layout>
