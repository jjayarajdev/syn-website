---
import Layout from '../../layouts/Layout.astro';

const capabilities = [
  {
    name: 'Custom Domain LLMs',
    description: 'Tailored language models for Tax, Legal, and Finance domains. Customizable, secure, and tuned for your industry vocabulary and compliance requirements.',
    icon: '🧠',
  },
  {
    name: 'Agentic RAG',
    description: 'Home-grown accelerator for unstructured document extraction and retrieval-augmented generation. Process contracts, invoices, medical records, and more.',
    icon: '🔍',
  },
  {
    name: 'Vision Models',
    description: 'YOLO-based custom models for business-specific object detection. Quality inspection, asset tracking, safety compliance — visual AI for your use case.',
    icon: '👁️',
  },
  {
    name: 'Smart Prompts',
    description: 'Efficient behind-the-scenes prompting strategies for better throughput and productivity. Optimized token usage, structured outputs, chain-of-thought tuning.',
    icon: '⚙️',
  },
];

const phases = [
  {
    num: '01',
    name: 'Ideation',
    duration: 'Week 1',
    details: [
      'Stakeholder alignment workshops',
      'Business benefits identification',
      'Use case prioritization',
      'Success criteria definition',
    ],
  },
  {
    num: '02',
    name: 'Tech Stack',
    duration: 'Week 2',
    details: [
      'Architecture finalization',
      'Model selection & benchmarking',
      'Developer environment setup',
      'Data pipeline design',
    ],
  },
  {
    num: '03',
    name: 'Rapid Build',
    duration: 'Weeks 2-3',
    details: [
      'Accelerated prototyping with our toolkit',
      'Integration with your systems',
      'Iterative demos with stakeholders',
      'Performance optimization',
    ],
  },
  {
    num: '04',
    name: 'Toll Gate',
    duration: 'Week 4',
    details: [
      'Go / No-Go decision point',
      'Production roadmap if Go',
      'Full documentation & handover',
      'ROI analysis & scaling plan',
    ],
  },
];

const techStack = [
  { category: 'AI/ML', items: ['Python', 'PyTorch', 'Keras', 'TensorFlow', 'LangChain', 'MLflow'] },
  { category: 'LLMs', items: ['OpenAI', 'Claude', 'AWS Bedrock', 'Llama', 'Falcon', 'DSPy'] },
  { category: 'Infra', items: ['Kubernetes', 'Docker', 'AWS', 'Azure', 'GCP'] },
];
---

<Layout title="Catalyst Studio — AI MVP Factory | Syntegreti" description="Syntegreti's proprietary AI accelerator. Go from idea to working proof in 4 weeks with our Proof of Tech methodology.">

  <!-- Hero -->
  <section class="relative pt-32 pb-20 overflow-hidden">
    <div class="absolute inset-0 grid-bg opacity-20"></div>
    <div class="absolute top-1/3 -left-32 h-96 w-96 rounded-full bg-accent/5 blur-[120px]"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-6">
      <div class="max-w-3xl" data-animate>
        <div class="mb-6 flex items-center gap-3">
          <span class="inline-flex items-center gap-2 rounded-full border border-accent/20 bg-accent/5 px-4 py-1.5 text-sm font-medium text-accent">
            Service
          </span>
          <span class="rounded-full border border-border px-3 py-1 text-xs text-text-muted">Proprietary AI Accelerator</span>
        </div>

        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
          <span class="gradient-text">Catalyst Studio</span>
        </h1>
        <p class="mt-2 font-mono text-lg text-text-muted">
          Our MVP Factory
        </p>
        <p class="mt-6 text-lg leading-relaxed text-text-secondary">
          A proprietary accelerator platform that takes your AI idea from concept to
          working proof in 4 weeks. We de-risk innovation through rigorous feasibility
          validation — so you see results before you commit. Our toolkit includes custom
          domain LLMs, agentic RAG, vision models, and optimized prompting strategies.
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/contact" class="group inline-flex items-center gap-2 rounded-xl bg-accent px-7 py-3.5 text-sm font-semibold text-void transition-all hover:bg-accent-glow hover:shadow-[0_0_30px_rgba(0,232,123,0.3)]">
            Book a 4-Week Sprint
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- POT Methodology -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-12" data-animate>
        <span class="font-mono text-sm text-accent">// proof_of_tech</span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          4-Week Innovation Sprint
        </h2>
        <p class="mt-4 max-w-2xl text-text-secondary">
          Our Proof of Tech methodology is a specialized approach for complex, deep-tech
          problem solving. We de-risk innovation through rigorous feasibility validation
          before you scale.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4" data-stagger>
        {phases.map((phase) => (
          <div class="rounded-2xl border border-border bg-surface/30 p-6 transition-all card-hover">
            <div class="flex items-center gap-3 mb-4">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-accent/20 bg-accent/5">
                <span class="font-mono text-sm font-bold text-accent">{phase.num}</span>
              </div>
              <div>
                <h3 class="text-sm font-bold text-text-primary">{phase.name}</h3>
                <span class="font-mono text-xs text-text-muted">{phase.duration}</span>
              </div>
            </div>
            <ul class="space-y-2">
              {phase.details.map((detail) => (
                <li class="flex items-start gap-2 text-xs text-text-secondary">
                  <svg class="mt-0.5 h-3 w-3 shrink-0 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {detail}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-12" data-animate>
        <span class="font-mono text-sm text-accent">// our_toolkit</span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          Built-In AI Capabilities
        </h2>
        <p class="mt-4 max-w-2xl text-text-secondary">
          Every sprint leverages our proprietary toolkit — so we're not starting from
          scratch. We're assembling proven components into your solution.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2" data-stagger>
        {capabilities.map((cap) => (
          <div class="rounded-2xl border border-border bg-surface/20 p-8 transition-all card-hover">
            <span class="text-3xl">{cap.icon}</span>
            <h3 class="mt-4 text-lg font-bold text-text-primary">{cap.name}</h3>
            <p class="mt-3 text-sm leading-relaxed text-text-secondary">{cap.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What You Get -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-6">
      <div class="rounded-2xl border border-accent/10 bg-gradient-to-br from-accent/5 via-surface/30 to-transparent p-10" data-animate>
        <span class="font-mono text-sm text-accent">// deliverables</span>
        <h2 class="mt-3 text-2xl font-bold">What You Get After 4 Weeks</h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {[
            'Working prototype demonstrating feasibility',
            'Architecture document and technical roadmap',
            'Performance benchmarks and accuracy metrics',
            'Go/No-Go recommendation with evidence',
            'Production scaling plan with timeline',
            'Full source code and documentation',
          ].map((item) => (
            <div class="flex items-start gap-3 rounded-xl border border-border bg-deep/50 p-4">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-sm text-text-secondary">{item}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Tech Stack -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-6">
      <div class="rounded-2xl border border-border bg-surface/20 p-10" data-animate>
        <span class="font-mono text-sm text-accent">// technology</span>
        <h2 class="mt-3 text-xl font-bold">Technology Stack</h2>
        <div class="mt-6 space-y-4">
          {techStack.map((group) => (
            <div>
              <span class="block text-xs font-semibold uppercase tracking-wider text-text-muted mb-2">{group.category}</span>
              <div class="flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <span class="rounded-md border border-border px-3 py-1.5 font-mono text-xs text-text-secondary hover:border-accent/30 hover:text-accent transition-colors">{item}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-6">
      <div class="rounded-2xl border border-accent/20 bg-gradient-to-br from-accent/5 to-surface p-12 text-center" data-animate>
        <h2 class="text-3xl font-bold tracking-tight">
          4 weeks. Zero guesswork.<br />
          <span class="gradient-text">Prove it before you scale it.</span>
        </h2>
        <p class="mx-auto mt-4 max-w-lg text-text-secondary">
          Tell us your AI challenge. We'll tell you if it's solvable — and prove it.
        </p>
        <a href="/contact" class="mt-8 inline-flex items-center gap-2 rounded-xl bg-accent px-8 py-4 text-sm font-semibold text-void transition-all hover:bg-accent-glow hover:shadow-[0_0_30px_rgba(0,232,123,0.3)]">
          Book a 4-Week Sprint
        </a>
      </div>
    </div>
  </section>
</Layout>
