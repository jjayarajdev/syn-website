---
import Layout from '../../layouts/Layout.astro';

const capabilities = [
  {
    pillar: 'Data Engineering',
    tagline: 'The foundation everything else depends on',
    items: [
      'BI & Data Warehousing',
      'ETL & Data Pipelines',
      'Data Quality & Governance',
      'Self-Service Analytics',
      'Data Lake Architecture',
    ],
  },
  {
    pillar: 'AI & Machine Learning',
    tagline: 'From classical ML to cutting-edge GenAI',
    items: [
      'GenAI & LLM Solutions',
      'Custom Domain Models',
      'Classical ML Models',
      'Rapid Prototyping (MVP)',
      'Model Monitoring & Ops',
    ],
  },
];

const aiCapabilities = [
  { name: 'AI Strategy & Roadmap', phase: 'Consult' },
  { name: 'Use Case Assessment', phase: 'Consult' },
  { name: 'Governance Frameworks', phase: 'Consult' },
  { name: 'Classical ML Models', phase: 'Build' },
  { name: 'GenAI Applications', phase: 'Build' },
  { name: 'End-to-End Implementation', phase: 'Build' },
  { name: 'SLA-driven L0-L3', phase: 'Run' },
  { name: 'Model Monitoring', phase: 'Run' },
  { name: 'Performance Optimization', phase: 'Run' },
  { name: 'Emerging Tech Research', phase: 'Innovate' },
  { name: 'Proof of Tech (POT)', phase: 'Innovate' },
  { name: 'Custom Accelerators', phase: 'Innovate' },
];
---

<Layout title="Data & AI Services — Syntegreti" description="Full-stack data engineering and AI capabilities — from BI pipelines to production GenAI and LLM solutions.">

  <!-- Hero with neural network vibe -->
  <section class="relative pt-24 pb-10 overflow-hidden">
    <div class="absolute inset-0 grid-bg opacity-30"></div>
    <!-- Multiple gradient orbs for "AI" feeling -->
    <div class="absolute top-10 left-1/3 h-64 w-64 rounded-full bg-accent/6 blur-[100px]"></div>
    <div class="absolute top-40 right-1/4 h-48 w-48 rounded-full bg-accent/6 blur-[80px]"></div>
    <div class="absolute bottom-10 left-1/5 h-56 w-56 rounded-full bg-accent/4 blur-[90px]"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-6">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
        <div data-animate>
          <span class="font-mono text-sm text-accent">// data_and_ai</span>
          <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
            Data is the asset.<br />
            <span class="gradient-text">AI is the edge.</span>
          </h1>
          <p class="mt-6 text-lg leading-relaxed text-text-secondary">
            Full-stack capabilities from data pipelines to production GenAI. We don't
            just build models — we build the entire data infrastructure that makes
            AI work at enterprise scale.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/services/catalyst-studio" class="inline-flex items-center gap-2 rounded-xl bg-accent px-7 py-3.5 text-sm font-semibold text-void transition-all hover:bg-accent-glow hover:shadow-[0_0_30px_rgba(0,232,123,0.3)]">
              Explore Catalyst Studio
            </a>
            <a href="/contact" class="inline-flex items-center gap-2 rounded-xl border border-border px-7 py-3.5 text-sm font-medium text-text-secondary transition-all hover:border-border-light hover:bg-elevated">
              Talk to Our Team
            </a>
          </div>
        </div>

        <!-- AI model visualization -->
        <div class="hidden lg:block" data-animate>
          <div class="rounded-2xl border border-border bg-deep p-1">
            <div class="flex items-center gap-2 px-4 py-3 border-b border-border">
              <div class="h-3 w-3 rounded-full bg-rose/60"></div>
              <div class="h-3 w-3 rounded-full bg-amber/60"></div>
              <div class="h-3 w-3 rounded-full bg-accent/60"></div>
              <span class="ml-2 font-mono text-xs text-text-muted">catalyst_pipeline.py</span>
            </div>
            <pre class="p-6 font-mono text-xs leading-relaxed"><code><span class="text-cyan">from</span> catalyst <span class="text-cyan">import</span> Pipeline, DomainLLM

<span class="text-text-muted"># Your data → Our models → Your ROI</span>
pipeline = Pipeline(
    <span class="text-text-muted">source=</span><span class="text-accent">"enterprise_docs"</span>,
    <span class="text-text-muted">extract=</span>AgenticRAG(
        <span class="text-text-muted">model=</span>DomainLLM(<span class="text-accent">"finance"</span>),
        <span class="text-text-muted">accuracy=</span><span class="text-amber">0.95</span>,
    ),
    <span class="text-text-muted">vision=</span>YOLOv8(<span class="text-accent">"quality-inspect"</span>),
    <span class="text-text-muted">deploy=</span><span class="text-accent">"production"</span>,
)

result = <span class="text-cyan">await</span> pipeline.run()
<span class="text-text-muted"># → 4-6 weeks from concept to production</span>
<span class="text-cyan">print</span>(f<span class="text-accent">"ROI: ${'{'}result.savings:,.0f{'}'}/year"</span>)</code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Two pillars -->
  <section class="py-10">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid gap-8 lg:grid-cols-2" data-stagger>
        {capabilities.map((cap) => (
          <div class="rounded-2xl border border-border bg-surface/20 p-8">
            <h2 class="text-2xl font-bold text-text-primary">{cap.pillar}</h2>
            <p class="mt-1 font-mono text-xs text-accent">{cap.tagline}</p>
            <div class="mt-6 space-y-3">
              {cap.items.map((item) => (
                <div class="flex items-center gap-3 rounded-lg border border-border/50 bg-deep/30 px-4 py-3 transition-all hover:border-accent/20 hover:bg-accent/5">
                  <svg class="h-4 w-4 shrink-0 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="text-sm text-text-secondary">{item}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Consult / Build / Run / Innovate -->
  <section class="py-10">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-8" data-animate>
        <span class="font-mono text-sm text-accent">// ai_lifecycle</span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          Consult. Build. Run. Innovate.
        </h2>
        <p class="mt-4 max-w-2xl text-text-secondary">
          We cover the entire AI lifecycle — from strategy to production operations to
          cutting-edge research.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-3 lg:grid-cols-4" data-stagger>
        {['Consult', 'Build', 'Run', 'Innovate'].map((phase) => (
          <div class="rounded-2xl border border-border bg-surface/20 p-6">
            <h3 class="text-lg font-bold text-accent">{phase}</h3>
            <div class="mt-4 space-y-2">
              {aiCapabilities.filter(c => c.phase === phase).map((cap) => (
                <div class="text-xs text-text-muted">{cap.name}</div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AI/ML tech stack - the showpiece -->
  <section class="py-10">
    <div class="mx-auto max-w-7xl px-6">
      <div class="rounded-2xl border border-accent/10 bg-gradient-to-br from-accent/5 via-surface/30 to-accent/5 p-10" data-animate>
        <span class="font-mono text-sm text-accent">// ai_ml_arsenal</span>
        <h2 class="mt-3 text-xl font-bold mb-8">AI/ML Technology Arsenal</h2>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {[
            { category: 'Models & Frameworks', items: ['Python', 'PyTorch', 'Keras', 'TensorFlow', 'scikit-learn', 'XGBoost'], accent: 'accent' },
            { category: 'LLMs & GenAI', items: ['OpenAI', 'Claude', 'AWS Bedrock', 'Llama', 'Falcon', 'Mistral'], accent: 'accent' },
            { category: 'Orchestration', items: ['LangChain', 'DSPy', 'VoltAgent', 'CrewAI', 'MLflow', 'Weights & Biases'], accent: 'accent' },
            { category: 'Data Engineering', items: ['Spark', 'Airflow', 'dbt', 'Kafka', 'Snowflake', 'Databricks'], accent: 'accent' },
            { category: 'Vector & Search', items: ['Pinecone', 'Weaviate', 'ChromaDB', 'LibSQL', 'Elasticsearch'], accent: 'accent' },
            { category: 'Infrastructure', items: ['NVIDIA GPUs', 'AWS SageMaker', 'Vertex AI', 'Azure ML', 'Kubernetes'], accent: 'accent' },
          ].map((group) => (
            <div>
              <span class={`block text-xs font-semibold uppercase tracking-wider text-${group.accent} mb-3`}>{group.category}</span>
              <div class="flex flex-wrap gap-1.5">
                {group.items.map((item) => (
                  <span class={`rounded-md border border-border bg-deep px-2.5 py-1 font-mono text-xs text-text-secondary transition-colors hover:border-${group.accent}/30 hover:text-${group.accent}`}>{item}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Link to Catalyst Studio -->
  <section class="py-10">
    <div class="mx-auto max-w-7xl px-6">
      <a href="/services/catalyst-studio" class="group block rounded-2xl border border-accent/20 bg-accent/5 p-8 transition-all hover:border-accent/40 hover:bg-accent/10" data-animate>
        <div class="flex items-center justify-between">
          <div>
            <span class="font-mono text-xs text-accent">Proprietary Accelerator</span>
            <h3 class="mt-1 text-xl font-bold text-text-primary">Catalyst Studio — Our AI MVP Factory</h3>
            <p class="mt-2 max-w-lg text-sm text-text-secondary">
              Custom Domain LLMs, Agentic RAG, Vision Models, Smart Prompts — all deployed
              through our 4-6 week Proof of Tech sprint.
            </p>
          </div>
          <svg class="h-6 w-6 shrink-0 text-accent transition-transform group-hover:translate-x-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </div>
      </a>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-10">
    <div class="mx-auto max-w-7xl px-6">
      <div class="rounded-2xl border border-accent/20 bg-gradient-to-br from-accent/5 to-surface p-12 text-center" data-animate>
        <h2 class="text-3xl font-bold tracking-tight">
          Your data has stories to tell.<br />
          <span class="gradient-text">Let's make them profitable.</span>
        </h2>
        <a href="/contact" class="mt-8 inline-flex items-center gap-2 rounded-xl bg-accent px-8 py-4 text-sm font-semibold text-void transition-all hover:bg-accent-glow hover:shadow-[0_0_30px_rgba(0,232,123,0.3)]">
          Start a Conversation
        </a>
      </div>
    </div>
  </section>
</Layout>
