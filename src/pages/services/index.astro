---
import Layout from '../../layouts/Layout.astro';

const pillars = [
  {
    title: 'Catalyst Studio',
    tagline: 'Our MVP Factory',
    description: 'Idea to working proof in 4-6 weeks. We de-risk your AI investment with a proprietary toolkit and a Go/No-Go gate before you scale.',
    href: '/services/catalyst-studio',
    color: 'accent',
    features: [
      '4-6 Week Proof of Tech',
      'Custom Domain LLMs',
      'Agentic RAG',
      'Vision Models (YOLO)',
      'Smart Prompts',
      'Full Source Handover',
    ],
  },
  {
    title: 'Build & Modernize',
    tagline: 'Apps + Cloud',
    description: 'Enterprise applications and cloud infrastructure — built right the first time. Salesforce, Workday, custom full-stack, plus strategy-led migration on AWS, Azure, and GCP.',
    href: '/services/application-services',
    color: 'accent',
    features: [
      'Salesforce & Workday',
      'Custom Full-Stack',
      'Cloud Migration',
      'Re-architecture',
      'Kubernetes & Terraform',
      'Managed Services',
    ],
  },
  {
    title: 'Data & AI',
    tagline: 'Intelligence at Scale',
    description: 'The heart of everything we do. From BI pipelines to production GenAI — we build the entire data infrastructure that makes AI work at enterprise scale.',
    href: '/services/data-ai',
    color: 'accent',
    features: [
      'GenAI & LLM Solutions',
      'Data Pipelines & ETL',
      'Retrieval-Augmented Gen',
      'Classical ML Models',
      'BI & Analytics',
      'MLOps & Monitoring',
    ],
  },
  {
    title: 'Operate & Secure',
    tagline: 'Infra + Cybersecurity',
    description: '24/7 operations, cybersecurity, and service desk — AI-augmented by our agent platform. We keep it running so your team can focus on what\'s next.',
    href: '/services/infrastructure',
    color: 'accent',
    features: [
      '24/7 NOC & SOC',
      'Cybersecurity',
      'Service Desk (L0-L3)',
      'AI Ticket Triage',
      'Data Center Ops',
      'Infrastructure Advisory',
    ],
  },
];
---

<Layout title="Services — Syntegreti" description="Enterprise AI and IT services: Catalyst Studio (4-6 week MVP factory), Build & Modernize, Data & AI, Operate & Secure.">
  <section class="relative pt-24 pb-10">
    <div class="absolute inset-0 grid-bg opacity-20"></div>
    <div class="absolute top-1/3 -right-32 h-96 w-96 rounded-full bg-accent/5 blur-[120px]"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-6">
      <div class="max-w-3xl mb-10" data-animate>
        <span class="font-mono text-sm text-accent">// service_portfolio</span>
        <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
          Four pillars.<br />
          <span class="gradient-text">One team.</span>
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-text-secondary">
          Invent it. Build it. Power it. Protect it. Most companies our size
          do one of these. We do all four — because that's what enterprises need.
        </p>
      </div>

      <!-- 4 Pillars -->
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        {pillars.map((pillar) => (
          <a
            href={pillar.href}
            class="group glow-card-subtle p-7 flex flex-col"
          >
            <div class="mb-5">
            </div>

            <h2 class={`text-lg font-bold text-${pillar.color}`}>{pillar.title}</h2>
            <p class="mt-1 font-mono text-[13px] text-text-secondary">{pillar.tagline}</p>

            <p class="mt-3 text-xs leading-relaxed text-text-secondary flex-1">
              {pillar.description}
            </p>

            <div class="mt-5 pt-4 border-t border-border/50 space-y-1.5">
              {pillar.features.map((f) => (
                <div class="rounded-md bg-deep/60 px-2.5 py-1.5 text-[13px] text-text-secondary text-center">
                  {f}
                </div>
              ))}
            </div>

<div class={`mt-5 flex items-center justify-center gap-1 text-xs font-medium text-${pillar.color} opacity-0 transition-opacity group-hover:opacity-100`}>
              Explore
              <svg class="h-3 w-3 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
