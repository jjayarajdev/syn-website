---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Layout title="Blog — Syntegreti" description="Perspectives on AI agents, enterprise architecture, and building products from a 25-person team.">
  <section class="relative pt-32 pb-20">
    <div class="absolute inset-0 grid-bg opacity-20"></div>
    <div class="absolute top-1/3 -right-32 h-96 w-96 rounded-full bg-accent/5 blur-[120px]"></div>

    <div class="relative z-10 mx-auto max-w-4xl px-6">
      <div class="mb-16" data-animate>
        <span class="font-mono text-sm text-accent">// blog</span>
        <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
          Thinking out loud.
        </h1>
        <p class="mt-4 text-lg text-text-secondary">
          What we're building, what we're learning, and what we think
          enterprises are getting wrong about AI.
        </p>
      </div>

      <div class="space-y-6" data-stagger>
        {posts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="group glow-card-subtle block p-8"
          >
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <time
                datetime={post.data.date.toISOString()}
                class="font-mono text-xs text-text-muted"
              >
                {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <span class="text-text-muted">·</span>
              <span class="font-mono text-xs text-text-muted">{post.data.readTime}</span>
            </div>

            <h2 class="text-xl font-bold text-text-primary sm:text-2xl group-hover:text-accent transition-colors">
              {post.data.title}
            </h2>

            <p class="mt-3 text-sm leading-relaxed text-text-secondary line-clamp-3">
              {post.data.description}
            </p>

            <div class="mt-4 flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="rounded-md bg-elevated px-2.5 py-1 font-mono text-[11px] text-text-secondary">
                  {tag}
                </span>
              ))}
            </div>

            <div class="mt-5 flex items-center gap-2 text-sm font-medium text-accent opacity-0 transition-opacity group-hover:opacity-100">
              Read article
              <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
          </a>
        ))}
      </div>

      {posts.length === 0 && (
        <div class="text-center py-20">
          <p class="text-text-muted">No posts yet. Check back soon.</p>
        </div>
      )}
    </div>
  </section>
</Layout>
