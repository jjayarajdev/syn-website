---
import Layout from '../layouts/Layout.astro';

const values = [
  {
    title: 'AI-First Thinking',
    description: 'Every solution we design starts with the question: how can AI make this 10x better? Not as an afterthought — as the foundation.',
    icon: '🧠',
  },
  {
    title: 'Prove It in 4 Weeks',
    description: 'We don\'t sell decks. Our Proof of Tech methodology delivers working prototypes in 4 weeks with a Go/No-Go gate. You see results before you commit.',
    icon: '⚡',
  },
  {
    title: 'Ship, Don\'t Theorize',
    description: 'We\'re builders, not advisors. From custom domain LLMs to agentic systems, we write the code, deploy the infra, and measure the ROI.',
    icon: '🚀',
  },
  {
    title: 'Deep, Not Wide',
    description: 'Six industry verticals. Mastered. We go deep into manufacturing, healthcare, lifesciences, engineering, insurance, and banking.',
    icon: '🎯',
  },
];

const timeline = [
  {
    phase: 'Foundation',
    description: 'Started as an enterprise IT services company with deep roots in application development, cloud transformation, and infrastructure management.',
  },
  {
    phase: 'AI Pivot',
    description: 'Recognized the transformative potential of AI/ML early. Built internal capabilities in classical ML, data engineering, and business intelligence.',
  },
  {
    phase: 'GenAI Era',
    description: 'Went all-in on generative AI. Developed Catalyst Studio, our proprietary accelerator platform with custom domain LLMs, agentic RAG, and vision models.',
  },
  {
    phase: 'Products',
    description: 'Launched BetterSDLC, Workweave, and Datacenter Solutions — moving from services-only to a product-led AI company with global delivery.',
  },
];

const stats = [
  { value: '100+', label: 'Years Combined Leadership Experience' },
  { value: '25+', label: 'Skilled Engineers & AI Specialists' },
  { value: '6', label: 'Industry Verticals' },
  { value: '4 Weeks', label: 'From Idea to Working Proof' },
];
---

<Layout title="About — Syntegreti" description="Syntegreti is an AI-first company building products and delivering services that transform how enterprises operate. HQ in Hyderabad, delivering globally.">
  <!-- Hero -->
  <section class="relative pt-32 pb-20">
    <div class="absolute inset-0 grid-bg opacity-20"></div>
    <div class="absolute top-1/3 -left-32 h-96 w-96 rounded-full bg-accent/5 blur-[120px]"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-6">
      <div class="max-w-3xl" data-animate>
        <span class="font-mono text-sm text-accent">// about_us</span>
        <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
          The synergy of<br />
          <span class="gradient-text">technology & human expertise.</span>
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-text-secondary">
          Syntegreti was founded on a simple belief: the most powerful outcomes happen
          when cutting-edge AI meets deep domain expertise. We're a mid-sized, globally
          capable team headquartered in Hyderabad, India — building AI products and
          delivering enterprise services across six industries.
        </p>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid grid-cols-2 gap-6 lg:grid-cols-4" data-stagger>
        {stats.map((stat) => (
          <div class="rounded-2xl border border-border bg-surface/30 p-8 text-center">
            <div class="text-3xl font-bold text-accent">{stat.value}</div>
            <div class="mt-2 text-sm text-text-muted">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Mission -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-6">
      <div class="rounded-2xl border border-accent/10 bg-gradient-to-br from-accent/5 via-surface/30 to-cyan/5 p-12 sm:p-16" data-animate>
        <div class="mx-auto max-w-3xl text-center">
          <span class="font-mono text-sm text-accent">// our_mission</span>
          <blockquote class="mt-4 text-2xl font-bold leading-relaxed tracking-tight sm:text-3xl">
            "To harness the power of synergy in technology and human expertise
            to deliver exceptional, AI-first solutions for today's complex
            business challenges."
          </blockquote>
          <div class="mt-6 flex items-center justify-center gap-4 text-sm text-text-muted">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-border px-3 py-1">
              Custom Solutions
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full border border-border px-3 py-1">
              Strategic Partnerships
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full border border-border px-3 py-1">
              Continuous Improvement
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-12" data-animate>
        <span class="font-mono text-sm text-accent">// how_we_think</span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Our Principles</h2>
      </div>

      <div class="grid gap-6 sm:grid-cols-2" data-stagger>
        {values.map((value) => (
          <div class="rounded-2xl border border-border bg-surface/20 p-8 transition-all card-hover">
            <span class="text-3xl">{value.icon}</span>
            <h3 class="mt-4 text-lg font-bold text-text-primary">{value.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-secondary">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Journey -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-12" data-animate>
        <span class="font-mono text-sm text-accent">// our_journey</span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">How We Got Here</h2>
      </div>

      <div class="relative" data-animate>
        <!-- Vertical line -->
        <div class="absolute left-6 top-0 bottom-0 w-px bg-gradient-to-b from-accent/50 via-accent/20 to-transparent lg:left-1/2"></div>

        <div class="space-y-12">
          {timeline.map((item, i) => (
            <div class={`relative flex items-start gap-8 ${i % 2 === 0 ? 'lg:flex-row' : 'lg:flex-row-reverse'}`}>
              {/* Dot */}
              <div class="absolute left-6 -translate-x-1/2 lg:left-1/2">
                <div class="flex h-3 w-3 items-center justify-center rounded-full border-2 border-accent bg-void"></div>
              </div>

              {/* Content */}
              <div class={`ml-12 lg:ml-0 lg:w-1/2 ${i % 2 === 0 ? 'lg:pr-16 lg:text-right' : 'lg:pl-16'}`}>
                <div class="rounded-xl border border-border bg-surface/20 p-6">
                  <span class="font-mono text-xs text-accent">{item.phase}</span>
                  <p class="mt-2 text-sm leading-relaxed text-text-secondary">{item.description}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-12" data-animate>
        <span class="font-mono text-sm text-accent">// our_team</span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Leadership</h2>
        <p class="mt-4 max-w-2xl text-lg text-text-secondary">
          A team with 100+ years of combined experience across enterprise IT,
          AI/ML, cloud infrastructure, and digital transformation.
        </p>
      </div>

      <div class="rounded-2xl border border-border bg-surface/20 p-12 text-center" data-animate>
        <div class="mx-auto max-w-md">
          <div class="mb-6 inline-flex h-20 w-20 items-center justify-center rounded-2xl border border-border bg-elevated">
            <span class="text-3xl">👥</span>
          </div>
          <h3 class="text-xl font-bold text-text-primary">25+ Engineers & Specialists</h3>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary">
            Full-stack developers, AI/ML engineers, cloud architects, data scientists,
            and domain experts — headquartered in Hyderabad with global delivery capability.
          </p>
          <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
            <span class="rounded-full border border-border px-3 py-1 text-xs text-text-muted">AI/ML Engineers</span>
            <span class="rounded-full border border-border px-3 py-1 text-xs text-text-muted">Full-Stack Developers</span>
            <span class="rounded-full border border-border px-3 py-1 text-xs text-text-muted">Cloud Architects</span>
            <span class="rounded-full border border-border px-3 py-1 text-xs text-text-muted">Data Scientists</span>
            <span class="rounded-full border border-border px-3 py-1 text-xs text-text-muted">Domain Experts</span>
            <span class="rounded-full border border-border px-3 py-1 text-xs text-text-muted">DevOps Engineers</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-6">
      <div class="rounded-2xl border border-accent/20 bg-gradient-to-br from-accent/5 to-surface p-12 text-center" data-animate>
        <h2 class="text-3xl font-bold tracking-tight">Want to work with us?</h2>
        <p class="mx-auto mt-4 max-w-lg text-text-secondary">
          We're always looking for challenging AI problems to solve. Let's talk.
        </p>
        <a
          href="/contact"
          class="mt-8 inline-flex items-center gap-2 rounded-xl bg-accent px-8 py-4 text-sm font-semibold text-void transition-all hover:bg-accent-glow hover:shadow-[0_0_30px_rgba(0,232,123,0.3)]"
        >
          Get in Touch
        </a>
      </div>
    </div>
  </section>
</Layout>
