---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

// Photos present under public/team/ (resolved at build time; empty until files are added)
const teamPhotos = Object.keys(import.meta.glob('/public/team/*.{jpg,jpeg,png,webp}'));

// Leadership — what each person does at Syntegreti (not a CV). Drop a photo at
// public/team/<slug>.jpg to replace the initials avatar automatically.
const leaders = [
  {
    name: 'Jay Jayakeerthy',
    slug: 'jay-jayakeerthy',
    role: 'Thinker · Tinkerer · Doer',
    owns: 'Platforms, delivery, clients',
    bio: 'Architects and ships the platforms and runs delivery, mostly for regulated industries where AI has to respect controls, not just answer questions.',
    linkedin: 'https://www.linkedin.com/in/jjayakeerthy/',
  },
  {
    name: 'Karthik Jayaraman',
    slug: 'karthik-jayaraman',
    role: 'AI and Technology Officer',
    owns: 'AI, business operations, delivery',
    bio: 'Architects and ships the AI that runs business operations: the agentic RAG, the cloud-first architecture, and the governance that keeps it working in production.',
    linkedin: 'https://www.linkedin.com/in/karthik-jayaraman-73909084/',
  },
  {
    name: 'Manish Davda',
    slug: 'manish-davda',
    role: 'Partnership Architect',
    owns: 'Partnerships, accounts, relationships',
    bio: 'Brings in the partnerships and looks after every account: the first conversation, the sprint scope, and the relationship once the system is live.',
    linkedin: 'https://www.linkedin.com/in/manish-davda-7993975/',
  },
].map((l) => {
  const match = teamPhotos.find((f) => f.includes(`/team/${l.slug}.`));
  return {
    ...l,
    photo: match ? match.replace(/^\/public/, '') : null,
    initials: l.name.split(' ').map((w) => w[0]).join(''),
  };
});

// Proof — one line per client system, pulled from the case studies
const shipped = [
  { tag: 'Insurance Aggregator · Middle East', title: 'AI-assisted insurance sales platform', metric: 'Live · 30+ locations · 35+ carriers', href: '/case-studies/insurance-sales-platform' },
  { tag: 'Enterprise IT', title: 'Multi-agent IT support desk', metric: '60% fewer tickets · 2-min resolution · $72K/yr saved', href: '/case-studies/ai-it-support' },
  { tag: 'Field Services · US', title: 'Omni-channel AI scheduling assistant', metric: 'Live · voice, web chat and SMS · zero wait time', href: '/case-studies/ai-scheduling-assistant' },
  { tag: 'Home Improvement · Nationwide US', title: 'License & contractor compliance platform', metric: 'In delivery · state, county and city jurisdictions', href: '/case-studies/contractor-compliance-platform' },
];

const schema = leaders.map((l) => ({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: l.name,
  jobTitle: l.role,
  description: l.bio,
  sameAs: [l.linkedin],
  worksFor: { '@type': 'Organization', name: 'Syntegreti', url: 'https://syntegreti.com' },
}));

const values = [
  {
    title: 'Build First, Pitch Second',
    icon: 'zap',
    description: 'We don\'t sell decks. We build working proofs in 4-6 weeks, then let the results do the talking. If it doesn\'t work, we tell you — not invoice you.',
  },
  {
    title: 'Everyone Ships',
    icon: 'users',
    description: 'No project managers who\'ve never written code. No architects who\'ve never debugged production. Every person on our team builds, deploys, and supports.',
  },
  {
    title: 'Stay Small, Go Deep',
    icon: 'target',
    description: 'We could hire 200 people and dilute. Instead, we stay lean, choose hard problems, and outbuild teams ten times our size through craft and AI leverage.',
  },
  {
    title: 'Own the Outcome',
    icon: 'handshake',
    description: 'We don\'t hand off requirements to offshore teams. The engineer who talks to you on day one is the same person deploying your solution on day thirty.',
  },
];

const timeline = [
  {
    phase: 'Enterprise IT roots',
    description: 'Decades spent inside enterprise application development, cloud transformation and infrastructure. We know how large systems are actually run, and what breaks them.',
  },
  {
    phase: 'ML and data discipline',
    description: 'Classical machine learning, data engineering and business intelligence, built before generative AI made it fashionable. The habits of measuring before believing came from here.',
  },
  {
    phase: 'GenAI and Catalyst Studio',
    description: 'Went all-in on generative AI: custom domain LLMs, agentic RAG and vision models, packaged into Catalyst Studio, the accelerator behind every 4-6 week sprint.',
  },
  {
    phase: 'Seven platforms',
    description: 'Working software built in-house on one AI spine, deployed inside client environments, each with a pilot available today.',
    href: '/products',
    linkLabel: 'See the platforms',
  },
]

const stats = [
  { value: '100+', label: 'Years combined leadership experience', href: '#leadership' },
  { value: '7', label: 'Platforms built in-house', href: '/products' },
  { value: '6', label: 'Industries where we\'ve delivered', href: '/case-studies' },
  { value: '4-6 wks', label: 'From "can we?" to "here\'s the proof"', href: '/services/catalyst-studio' },
];
---

<Layout schema={schema} title="About — Syntegreti" description="Meet the people behind Syntegreti: a lean Hyderabad team that builds AI platforms and ships enterprise systems — seven platforms in-house, client systems in production, proof in 4-6 weeks.">
  <!-- Hero -->
  <section class="relative pt-24 pb-10">
    <div class="absolute inset-0 grid-bg opacity-20"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-6">
      <div class="max-w-3xl" data-animate>
        <span class="font-mono text-sm text-accent">// about_us</span>
        <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
          Lean. Opinionated.<br />
          <span class="gradient-text">Zero bluff.</span>
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-text-secondary">
          We're a growing, focused team out of Hyderabad that builds AI products and
          ships enterprise solutions to clients around the world. We don't have a sales
          army or a partner ecosystem — we have engineers who know their craft, a toolkit
          we built ourselves, and a 4-6 week sprint that proves whether something works
          before anyone writes a big check.
        </p>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-8">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid grid-cols-2 gap-6 lg:grid-cols-4" data-stagger>
        {stats.map((stat) => (
          <a href={stat.href} class="group rounded-2xl border border-border bg-surface/30 p-8 text-center transition-all card-hover">
            <div class="text-3xl font-bold text-accent">{stat.value}</div>
            <div class="mt-2 text-sm text-text-muted underline-offset-2 group-hover:underline">{stat.label}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Leadership -->
  <section class="py-10" id="leadership">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-8" data-animate>
        <span class="font-mono text-sm text-accent">// who_you_talk_to</span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">The people on the other end of the call</h2>
        <p class="mt-4 max-w-2xl text-lg text-text-secondary">
          The leadership you work with directly, from the first conversation to
          production. Behind them, a growing team of engineers who build, ship and
          talk to clients. No layers in between.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-3" data-stagger>
        {leaders.map((l) => (
          <div class="flex flex-col gap-6 rounded-2xl border border-border bg-surface/20 p-8">
            {l.photo ? (
              <img src={l.photo} alt={l.name} width="112" height="112" loading="lazy" class="h-28 w-28 shrink-0 object-cover grayscale" />
            ) : (
              <div class="flex h-28 w-28 shrink-0 items-center justify-center border border-border bg-deep font-display text-3xl font-bold text-accent" aria-hidden="true">
                {l.initials}
              </div>
            )}
            <div class="min-w-0">
              <h3 class="text-xl font-bold text-text-primary">{l.name}</h3>
              <div class="mt-1 font-mono text-xs text-accent">{l.role}</div>
              <div class="mt-1 text-sm text-text-muted">{l.owns}</div>
              <p class="mt-4 text-sm leading-relaxed text-text-secondary">{l.bio}</p>
              <a href={l.linkedin} target="_blank" rel="noopener" class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-accent transition-colors hover:text-accent-glow">
                <Icon name="linkedin" size={16} />
                LinkedIn
                <Icon name="arrow-up-right" size={14} />
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Shipped -->
  <section class="py-10">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4" data-animate>
        <div>
          <span class="font-mono text-sm text-accent">// what_we_have_shipped</span>
          <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Four client systems. Real numbers where we can share them.</h2>
        </div>
        <a href="/case-studies" class="inline-flex items-center gap-1 text-sm font-medium text-text-secondary transition-colors hover:text-text-primary">
          All case studies
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <div class="grid gap-4 md:grid-cols-2" data-stagger>
        {shipped.map((c) => (
          <a href={c.href} class="group rounded-2xl border border-border bg-surface/20 p-6 transition-all card-hover">
            <div class="font-mono text-xs text-text-muted">{c.tag}</div>
            <h3 class="mt-2 text-lg font-bold text-text-primary">{c.title}</h3>
            <div class="mt-3 text-sm text-accent">{c.metric}</div>
            <div class="mt-4 inline-flex items-center gap-1 text-sm text-text-secondary transition-colors group-hover:text-text-primary">
              Read the case study
              <Icon name="arrow-right" size={14} />
            </div>
          </a>
        ))}
      </div>
      <p class="mt-6 text-sm text-text-muted">
        Plus <a href="/products" class="text-text-secondary underline underline-offset-2 hover:text-text-primary">seven platforms</a>
        built in-house and deployed inside client environments, each with a pilot available.
      </p>
    </div>
  </section>

  <!-- Mission -->
  <section class="py-10">
    <div class="mx-auto max-w-7xl px-6">
      <div class="rounded-2xl border border-accent/10 bg-surface/30 p-12 sm:p-16" data-animate>
        <div class="mx-auto max-w-3xl text-center">
          <span class="font-mono text-sm text-accent">// our_bet</span>
          <blockquote class="mt-4 text-2xl font-bold leading-relaxed tracking-tight sm:text-3xl">
            "A small team with the right tools and the right attitude
            can outbuild companies 100x their size. AI makes that bet
            a sure thing."
          </blockquote>
          <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-sm text-text-muted">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-border px-3 py-1">
              HQ Hyderabad, India
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full border border-border px-3 py-1">
              Global delivery
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full border border-border px-3 py-1">
              AWS Partner
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full border border-border px-3 py-1">
              Microsoft Azure Partner
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-10">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-8" data-animate>
        <span class="font-mono text-sm text-accent">// how_we_operate</span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">How a Lean Team Outbuilds the Big Guys</h2>
      </div>

      <div class="grid gap-6 sm:grid-cols-2" data-stagger>
        {values.map((value) => (
          <div class="rounded-2xl border border-border bg-surface/20 p-8 transition-all card-hover">
            <Icon name={value.icon} size={20} class="text-accent" />
            <h3 class="mt-4 text-lg font-bold text-text-primary">{value.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-secondary">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What we brought with us (indicative, not a dated history) -->
  <section class="py-10">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-8" data-animate>
        <span class="font-mono text-sm text-accent">// what_we_brought</span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">What We Arrived With</h2>
        <p class="mt-4 max-w-2xl text-lg text-text-secondary">
          The company is new. The people are not. Four things this team brought with them on day one.
        </p>
      </div>

      <!-- Horizontal strip: rule across the top, one step per column -->
      <div class="relative" data-stagger>
        <div class="absolute left-0 right-0 top-[5px] hidden h-px bg-border lg:block" aria-hidden="true"></div>
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {timeline.map((item, i) => (
            <div class="relative border-l border-border pl-5 lg:border-l-0 lg:pl-0 lg:pt-8">
              <div class="absolute -left-[6.5px] top-0 h-3 w-3 border-2 border-accent bg-void lg:left-0" aria-hidden="true"></div>
              <span class="font-mono text-xs text-accent">0{i + 1} · {item.phase}</span>
              <p class="mt-2 text-sm leading-relaxed text-text-secondary">{item.description}</p>
              {item.href && (
                <a href={item.href} class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-accent transition-colors hover:text-accent-glow">
                  {item.linkLabel}
                  <Icon name="arrow-right" size={14} />
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section class="py-10">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-8" data-animate>
        <span class="font-mono text-sm text-accent">// the_team</span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">The Team</h2>
        <p class="mt-4 max-w-2xl text-lg text-text-secondary">
          No bench. No "resources." Every person here chose to be here
          because they want to build things that matter.
        </p>
      </div>
      <div class="rounded-2xl border border-border bg-surface/20 p-12 text-center" data-animate>
        <div class="mx-auto max-w-lg">
          <h3 class="text-3xl font-bold tracking-tight">Engineers & Specialists — and Growing</h3>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary">
            Full-stack developers, AI/ML engineers, cloud architects, data scientists.
            Everyone codes. Everyone ships. Everyone talks to clients.
            Hyderabad HQ, global timezone coverage.
          </p>
          <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
            <span class="rounded-full border border-border px-3 py-1 text-xs text-text-muted">AI/ML Engineers</span>
            <span class="rounded-full border border-border px-3 py-1 text-xs text-text-muted">Full-Stack Developers</span>
            <span class="rounded-full border border-border px-3 py-1 text-xs text-text-muted">Cloud Architects</span>
            <span class="rounded-full border border-border px-3 py-1 text-xs text-text-muted">Data Scientists</span>
            <span class="rounded-full border border-border px-3 py-1 text-xs text-text-muted">Domain Experts</span>
            <span class="rounded-full border border-border px-3 py-1 text-xs text-text-muted">DevOps Engineers</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-10">
    <div class="mx-auto max-w-7xl px-6">
      <div class="rounded-2xl border border-accent/20 bg-surface/30 p-12 text-center" data-animate>
        <h2 class="text-3xl font-bold tracking-tight">Got a hard problem?</h2>
        <p class="mx-auto mt-4 max-w-lg text-text-secondary">
          We're a small team — so we're picky about what we take on. But if your
          problem is interesting, we'll move faster than you expect.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 rounded-xl bg-accent px-8 py-4 text-sm font-semibold text-void transition-all hover:bg-accent-glow hover:shadow-[0_0_30px_rgba(0,232,123,0.3)]"
          >
            Get in Touch
          </a>
          <a
            href="/case-studies"
            class="inline-flex items-center gap-2 rounded-xl border border-border px-8 py-4 text-sm font-medium text-text-secondary transition-all hover:border-border-light hover:bg-elevated hover:text-text-primary"
          >
            See What We've Shipped
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
