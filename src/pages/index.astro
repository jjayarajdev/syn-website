---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import AISpine from '../components/AISpine.astro';
import CaseStudies from '../components/CaseStudies.astro';
import CatalystStudio from '../components/CatalystStudio.astro';
import Services from '../components/Services.astro';
import WhyUs from '../components/WhyUs.astro';
import CTA from '../components/CTA.astro';
---

<Layout title="Syntegreti — Small Team. Big AI. Proven in 4 to 6 Weeks.">
  <Hero />
  <AISpine />

  <!-- The proof — the one section every visitor must register -->
  <div class="band-ink">
    <CaseStudies />
  </div>

  <CatalystStudio />

  <!-- Services on a recessed tint so the offer reads as its own chapter -->
  <div class="band-surface">
    <Services />
  </div>

  <WhyUs />

  <!-- The close — brand green, impossible to scroll past -->
  <div class="band-forest">
    <CTA />
  </div>
</Layout>
