---
import Layout from '../../layouts/Layout.astro';

const stack = [
  { name: 'Admin + Contractor Portals', tech: 'Next.js 15 · React 19 · Mapbox GL JS' },
  { name: 'Platform API', tech: 'NestJS 11 · PostgreSQL 16 · Redis' },
  { name: 'AI / OCR Service', tech: 'FastAPI · GPT-4o document extraction' },
  { name: 'Workflow Orchestration', tech: 'Temporal.io — durable monitoring pipelines' },
];

const scope = [
  {
    title: 'Jurisdiction Monitoring',
    desc: 'Licensing requirements tracked across state, county and city jurisdictions — with durable Temporal workflows watching the authoritative sources for change.',
  },
  {
    title: 'AI Document Verification',
    desc: 'Licenses and certificates of insurance read by AI/OCR extraction, with accuracy targets agreed in the contract — not marketing copy.',
  },
  {
    title: 'Compliance Status Engine',
    desc: 'Contractor compliance is pre-computed at write time, so the answer to "can this contractor work this job in this county?" is instant.',
  },
  {
    title: 'Two Portals, One Platform',
    desc: 'An admin portal for the compliance team and a self-service portal for contractors — onboarding, document upload, and status in one place.',
  },
];
---

<Layout title="License & Contractor Compliance Platform — Case Study | Syntegreti" description="Selected through a competitive RFP to build a License & Contractor Compliance Platform for one of America's largest home-improvement platforms — jurisdiction monitoring, AI document verification, and a pre-computed compliance engine. Now in delivery.">

  <!-- Hero -->
  <section class="relative pt-24 pb-8 overflow-hidden">
    <div class="absolute inset-0 grid-bg opacity-20"></div>
    <div class="absolute top-1/4 -right-32 h-96 w-96 rounded-full bg-accent/5 blur-[120px]"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-6">
      <div class="max-w-3xl" data-animate>
        <a href="/case-studies" class="inline-flex items-center gap-2 text-sm text-text-muted hover:text-text-secondary transition-colors mb-6">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          All Case Studies
        </a>

        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="inline-flex items-center gap-2 rounded-full border border-accent/20 bg-accent/5 px-4 py-1.5 text-sm font-medium text-accent">
            Home Improvement · Nationwide US
          </span>
          <span class="rounded-full border border-border px-3 py-1 text-xs text-text-muted">Contractor Compliance</span>
          <span class="rounded-full border border-amber/30 bg-amber/5 px-3 py-1 text-xs text-amber">In delivery</span>
        </div>

        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          License &amp; Contractor Compliance Platform
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-text-secondary">
          Selected through a competitive RFP to build the compliance backbone for
          <strong class="text-text-primary">one of America's largest
          home-improvement platforms</strong> — keeping thousands of contractor
          licenses and insurance documents verified across state, county and city
          jurisdictions.
        </p>
      </div>
    </div>
  </section>

  <!-- Why this is here without metrics -->
  <section class="py-8">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4" data-stagger>
        {[
          { value: 'RFP win', label: 'Selected vendor', sub: 'competitive process' },
          { value: 'PoC', label: 'Full stack validated', sub: 'built during the RFP' },
          { value: '3-level', label: 'Jurisdiction coverage', sub: 'state · county · city' },
          { value: 'In SOW', label: 'AI accuracy SLA', sub: 'contractual, not claimed' },
        ].map((m) => (
          <div class="rounded-xl border border-amber/20 bg-amber/5 p-5 text-center">
            <div class="text-2xl font-bold text-amber">{m.value}</div>
            <div class="text-xs font-medium text-text-primary">{m.label}</div>
            {m.sub && <div class="mt-0.5 text-[13px] text-text-secondary">{m.sub}</div>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The Challenge -->
  <section class="py-8">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid gap-12 lg:grid-cols-5">
        <div class="lg:col-span-2" data-animate>
          <span class="font-mono text-sm text-rose">// the_challenge</span>
          <h2 class="mt-3 text-3xl font-bold tracking-tight">
            Thousands of contractors.<br />
            Hundreds of jurisdictions.<br />
            <span class="text-rose">One compliance team.</span>
          </h2>
        </div>
        <div class="lg:col-span-3" data-animate>
          <div class="grid gap-4 sm:grid-cols-2">
            {[
              { title: 'Fragmented rules', desc: 'Every state, county and city writes its own licensing requirements — and changes them without telling anyone.' },
              { title: 'Manual verification', desc: 'Licenses and certificates of insurance checked by hand, document by document.' },
              { title: 'Expiry risk', desc: 'A lapsed license found late means stopped jobs and real regulatory exposure.' },
              { title: 'No single answer', desc: '"Is this contractor compliant for this job, here, today?" took research, not a lookup.' },
            ].map((c) => (
              <div class="rounded-xl border border-border/50 bg-surface/30 p-5">
                <h3 class="text-sm font-bold text-text-primary">{c.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-text-secondary">{c.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What we're building -->
  <section class="py-8">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-8" data-animate>
        <span class="font-mono text-sm text-accent">// the_platform</span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          Compliance as a lookup, not a project
        </h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2" data-stagger>
        {scope.map((s) => (
          <div class="glow-card-subtle p-7">
            <h3 class="text-lg font-bold text-accent">{s.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-text-secondary">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How we won -->
  <section class="py-8">
    <div class="mx-auto max-w-7xl px-6">
      <div class="rounded-2xl border border-accent/20 bg-accent/5 p-10" data-animate>
        <span class="font-mono text-sm text-accent">// how_we_won</span>
        <h2 class="mt-3 text-2xl font-bold">We didn't send a deck. We sent a working platform.</h2>
        <p class="mt-4 max-w-3xl text-sm leading-relaxed text-text-secondary">
          During the RFP — before any contract — we built a full-stack proof of
          concept: both portals, the API, the AI/OCR extraction service and the
          Temporal workflow engine, running end to end. The evaluation stopped
          being about promises and started being about a system the client could
          click through. That is the 4-week sprint model doing exactly what it
          is for.
        </p>
        <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {stack.map((s) => (
            <div class="rounded-lg border border-border/50 bg-deep/50 px-4 py-3">
              <div class="text-xs font-medium text-text-primary">{s.name}</div>
              <div class="mt-1 font-mono text-[13px] text-text-secondary">{s.tech}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Accountability -->
  <section class="py-8">
    <div class="mx-auto max-w-7xl px-6">
      <div class="rounded-2xl border border-border bg-surface/50 p-10" data-animate>
        <span class="font-mono text-sm text-accent">// accountability</span>
        <h2 class="mt-3 text-2xl font-bold">Results will be reported when they're real</h2>
        <p class="mt-4 max-w-3xl text-sm leading-relaxed text-text-secondary">
          This platform is in delivery, so you won't find outcome numbers on this
          page yet. What's already in place says more: contractual acceptance
          criteria per milestone, an AI extraction accuracy SLA, a hypercare
          period with defined response times, and full IP transfer to the client
          at go-live. We publish results when the client has them — not before.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-8">
    <div class="mx-auto max-w-4xl px-6 text-center" data-animate>
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Have a compliance problem that looks like this?
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-text-secondary">
        Regulated, jurisdiction-heavy, document-driven — this is the work we pick
        first. Start with a 4-week proof.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/contact" class="inline-flex items-center gap-2 rounded-xl bg-accent px-7 py-3.5 text-sm font-semibold text-void transition-all hover:bg-accent-glow hover:shadow-[0_0_30px_rgba(0,232,123,0.3)]">
          Talk to Us
        </a>
        <a href="/case-studies" class="inline-flex items-center gap-2 rounded-xl border border-border px-7 py-3.5 text-sm font-medium text-text-secondary transition-all hover:border-border-light hover:bg-elevated">
          All Case Studies
        </a>
      </div>
    </div>
  </section>
</Layout>
