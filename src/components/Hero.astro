---
---

<section class="relative min-h-[78vh] flex items-center overflow-hidden pt-16 aurora">
  <!-- Background grid -->
  <div class="absolute inset-0 grid-bg opacity-40 z-[1]"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 py-10">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-start">
      <div>
        <!-- Headline -->
        <h1 class="text-5xl font-bold leading-[1.1] tracking-tight sm:text-6xl lg:text-7xl" data-animate>
          Lean team.<br />
          <span class="gradient-text">Big AI.</span><br />
          <span class="text-text-secondary">Proven in</span>
          <span class="gradient-text"> 4-6 weeks.</span>
        </h1>

        <!-- Subheadline — tightened with "what" and "for whom" -->
        <p class="mt-8 max-w-xl text-lg leading-relaxed text-text-secondary" data-animate>
          We build AI platforms that run in your enterprise and the
          same engineers deliver your projects and extend your teams. No layers,
          no handoffs — the people who architect it are the people who deploy it.
        </p>

        <!-- For whom -->
        <p class="mt-3 font-mono text-sm text-text-muted" data-animate>
          For enterprises where AI has to work in production, not just in a pitch deck.
        </p>

        <!-- CTAs -->
        <div class="mt-10 flex flex-wrap items-center gap-4" data-animate>
          <a
            href="/contact"
            class="group inline-flex w-full items-center justify-center gap-2 rounded-xl bg-accent px-7 py-3.5 text-sm font-semibold text-void transition-all hover:bg-accent-glow hover:shadow-[0_0_30px_rgba(0,232,123,0.3)] sm:w-auto"
          >
            Book a 4-6 Week Sprint
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="#proof"
            class="inline-flex w-full items-center justify-center gap-2 rounded-xl glass px-7 py-3.5 text-sm font-medium text-text-secondary transition-all hover:text-text-primary sm:w-auto"
          >
            See the Proof
          </a>
        </div>

      </div>

      <!-- Right column: tag + typing terminal -->
      <div class="hidden lg:block" data-animate>
        <!-- Tag -->
        <div class="mb-6 flex justify-end">
          <span class="inline-flex items-center gap-2 rounded-full glass px-4 py-1.5 text-sm">
            <span class="h-2 w-2 rounded-full bg-accent"></span>
            <span class="text-text-secondary">AI-first company</span>
            <span class="text-text-muted">/</span>
            <span class="text-text-secondary">Platforms · Projects · Teams</span>
            <span class="text-text-muted">/</span>
            <span class="text-text-muted">Hyderabad → Global</span>
          </span>
        </div>
        <div class="glow-card-subtle">
          <div class="flex items-center gap-2 px-5 py-3 border-b border-border/50">
            <div class="h-3 w-3 rounded-full bg-rose/60"></div>
            <div class="h-3 w-3 rounded-full bg-amber/60"></div>
            <div class="h-3 w-3 rounded-full bg-accent/60"></div>
            <span class="ml-2 font-mono text-xs text-text-muted">catalyst-studio — live</span>
          </div>
          <div class="p-6 font-mono text-sm leading-relaxed min-h-[420px]" id="terminal">
            <div id="terminal-output"></div>
            <span id="terminal-cursor" class="typing-cursor"></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Proof strip — full-width base under both columns -->
    <div class="mt-12 flex flex-nowrap items-center justify-between gap-3 sm:gap-6 lg:gap-8 border-t border-border pt-8" data-animate>
      <div class="min-w-0">
        <div class="text-lg sm:text-2xl font-bold text-text-primary whitespace-nowrap">100+</div>
        <div class="text-[11px] sm:text-xs text-text-muted">Years combined<br/>experience</div>
      </div>
      <div class="h-10 w-px bg-border shrink-0"></div>
      <div class="min-w-0">
        <div class="text-lg sm:text-2xl font-bold text-text-primary whitespace-nowrap" data-counter="8">0</div>
        <div class="text-[11px] sm:text-xs text-text-muted">Platforms<br/>built in-house</div>
      </div>
      <div class="h-10 w-px bg-border shrink-0"></div>
      <div class="min-w-0">
        <div class="text-lg sm:text-2xl font-bold text-text-primary whitespace-nowrap">4-6 Weeks</div>
        <div class="text-[11px] sm:text-xs text-text-muted">Idea to<br/>working proof</div>
      </div>
      <div class="h-10 w-px bg-border shrink-0"></div>
      <div class="min-w-0">
        <div class="text-lg sm:text-2xl font-bold text-accent whitespace-nowrap" data-counter="3">0</div>
        <div class="text-[11px] sm:text-xs text-text-muted">Client systems<br/>in production</div>
      </div>
    </div>
  </div>
</section>

<script>
  // Terminal typing animation
  const lines = [
    { text: '$ catalyst init --sprint 4-6-weeks', color: 'text-accent', delay: 22 },
    { text: '', color: '', delay: 180 },
    { text: '  Scanning enterprise systems...', color: 'text-text-muted', delay: 12 },
    { text: '  ✓ Connected: Salesforce, Zoho, Snowflake', color: 'text-text-muted', delay: 12 },
    { text: '', color: '', delay: 120 },
    { text: '$ catalyst deploy --agent support-desk', color: 'text-accent', delay: 22 },
    { text: '', color: '', delay: 240 },
    { text: '  Orchestrating agents...', color: 'text-text-muted', delay: 12 },
    { text: '  ├─ Zoho Agent  [READY]', color: 'text-cyan', delay: 14 },
    { text: '  ├─ RAG Agent         [READY]', color: 'text-cyan', delay: 14 },
    { text: '  └─ Escalation Agent  [READY]', color: 'text-cyan', delay: 14 },
    { text: '', color: '', delay: 120 },
    { text: '  Tickets resolved:    847/mo', color: 'text-text-secondary', delay: 12 },
    { text: '  Avg resolution:      2 min (was 4 hrs)', color: 'text-text-secondary', delay: 12 },
    { text: '  Annual savings:      $72,000', color: 'text-accent', delay: 16 },
    { text: '', color: '', delay: 180 },
    { text: '  Status: SHIPPED ✓', color: 'text-accent', delay: 16 },
  ];

  const output = document.getElementById('terminal-output');
  const cursor = document.getElementById('terminal-cursor');
  if (!output || !cursor) throw new Error('Terminal elements not found');

  let lineIdx = 0;
  let charIdx = 0;
  let currentLine: HTMLDivElement | null = null;

  function type() {
    if (lineIdx >= lines.length) {
      setTimeout(() => {
        output!.innerHTML = '';
        lineIdx = 0;
        charIdx = 0;
        currentLine = null;
        type();
      }, 4000);
      return;
    }

    const line = lines[lineIdx];

    if (!currentLine) {
      currentLine = document.createElement('div');
      if (line.color) currentLine.className = line.color;
      currentLine.style.minHeight = '1.5em';
      output!.appendChild(currentLine);
    }

    if (charIdx < line.text.length) {
      currentLine.textContent += line.text[charIdx];
      charIdx++;
      setTimeout(type, line.delay);
    } else {
      lineIdx++;
      charIdx = 0;
      currentLine = null;
      setTimeout(type, line.delay);
    }
  }

  const terminalObserver = new IntersectionObserver(
    (entries) => {
      if (entries[0].isIntersecting) {
        setTimeout(type, 300);
        terminalObserver.disconnect();
      }
    },
    { threshold: 0.3 }
  );
  const termEl = document.getElementById('terminal');
  if (termEl) terminalObserver.observe(termEl);
</script>
