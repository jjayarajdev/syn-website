---
---

<section class="relative min-h-screen flex items-center overflow-hidden pt-24">
  <!-- Background grid -->
  <div class="absolute inset-0 grid-bg opacity-40"></div>

  <!-- Gradient orbs -->
  <div class="absolute top-1/4 -left-32 h-96 w-96 rounded-full bg-accent/5 blur-[120px]"></div>
  <div class="absolute bottom-1/4 -right-32 h-96 w-96 rounded-full bg-cyan/5 blur-[120px]"></div>

  <!-- Radial gradient fade at bottom -->
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-void"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 py-20">
    <div class="max-w-4xl">
      <!-- Tag -->
      <div class="mb-8" data-animate>
        <span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface/50 px-4 py-1.5 text-sm backdrop-blur-sm">
          <span class="h-2 w-2 rounded-full bg-accent animate-pulse"></span>
          <span class="text-text-secondary">AI-First Company</span>
          <span class="text-text-muted">·</span>
          <span class="text-text-muted">Est. Hyderabad</span>
        </span>
      </div>

      <!-- Headline -->
      <h1 class="text-5xl font-bold leading-[1.1] tracking-tight sm:text-6xl lg:text-7xl" data-animate>
        We build AI that<br />
        <span class="gradient-text">works.</span>
        <span class="text-text-secondary"> Then we</span><br />
        <span class="text-text-secondary">prove it in</span>
        <span class="gradient-text"> 4 weeks.</span>
      </h1>

      <!-- Subheadline -->
      <p class="mt-8 max-w-2xl text-lg leading-relaxed text-text-secondary sm:text-xl" data-animate>
        From custom LLMs and agentic systems to AI-ready infrastructure — we ship
        solutions with measurable ROI for enterprises in healthcare, manufacturing,
        insurance, and beyond.
      </p>

      <!-- CTAs -->
      <div class="mt-10 flex flex-wrap items-center gap-4" data-animate>
        <a
          href="/services/catalyst-studio"
          class="group inline-flex items-center gap-2 rounded-xl bg-accent px-7 py-3.5 text-sm font-semibold text-void transition-all hover:bg-accent-glow hover:shadow-[0_0_30px_rgba(0,232,123,0.3)]"
        >
          Explore Catalyst Studio
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href="/case-studies"
          class="inline-flex items-center gap-2 rounded-xl border border-border px-7 py-3.5 text-sm font-medium text-text-secondary transition-all hover:border-border-light hover:bg-elevated hover:text-text-primary"
        >
          See Case Studies
        </a>
      </div>

      <!-- Social proof strip -->
      <div class="mt-16 flex flex-wrap items-center gap-8 border-t border-border pt-8" data-animate>
        <div>
          <div class="text-2xl font-bold text-text-primary">100+</div>
          <div class="text-xs text-text-muted">Years Combined<br/>Leadership</div>
        </div>
        <div class="h-10 w-px bg-border"></div>
        <div>
          <div class="text-2xl font-bold text-text-primary">6</div>
          <div class="text-xs text-text-muted">Industry<br/>Verticals</div>
        </div>
        <div class="h-10 w-px bg-border"></div>
        <div>
          <div class="text-2xl font-bold text-text-primary">4 Weeks</div>
          <div class="text-xs text-text-muted">Proof of Tech<br/>Methodology</div>
        </div>
        <div class="h-10 w-px bg-border"></div>
        <div>
          <div class="text-2xl font-bold text-accent">$120k+</div>
          <div class="text-xs text-text-muted">Saved per Client<br/>Annually</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Decorative code block (right side, desktop only) -->
  <div class="absolute right-12 top-1/2 -translate-y-1/2 hidden opacity-20 xl:block">
    <pre class="font-mono text-xs leading-relaxed text-accent/60"><code>{"{"} <span class="text-cyan/60">agent</span>: "catalyst",
  <span class="text-cyan/60">mode</span>: "autonomous",
  <span class="text-cyan/60">models</span>: [
    "domain-llm",
    "agentic-rag",
    "vision-yolo"
  ],
  <span class="text-cyan/60">sprint</span>: "4-weeks",
  <span class="text-cyan/60">status</span>: <span class="text-accent">"shipping"</span>
{"}"}</code></pre>
  </div>
</section>
