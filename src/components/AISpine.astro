---
---

<section class="relative py-24" id="ai-spine">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-12" data-animate>
      <span class="font-mono text-sm text-accent">// the_ai_spine</span>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
        Two products. One AI spine.
      </h2>
      <p class="mt-4 max-w-2xl text-text-secondary">
        One helps your dev teams build better. The other helps your ops teams
        resolve faster. Together, they form the AI operating layer for your enterprise.
      </p>
    </div>

    <!-- Two-product spine -->
    <div class="glow-card-subtle p-8 md:p-10" data-animate>
      <div class="grid gap-8 md:gap-0 md:grid-cols-2">

        <!-- BetterSDLC -->
        <a href="/products/bettersdlc" class="group md:border-r md:border-border/50 md:pr-10">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">⚡</span>
            <h3 class="text-xl font-bold text-accent">BetterSDLC</h3>
          </div>
          <p class="font-mono text-[11px] text-text-muted mb-3">How you build software</p>
          <p class="text-sm leading-relaxed text-text-secondary">
            AI-guided SDLC workflows across five roles. Context threads between
            phases automatically. Full compliance audit trail for every
            AI-generated artifact. 40% less rework, $780k+ saved for a 50-dev team.
          </p>
          <div class="mt-4 flex items-center gap-1 text-xs font-medium text-accent opacity-0 transition-opacity group-hover:opacity-100">
            Learn more →
          </div>
        </a>

        <!-- Workweave -->
        <a href="/products/workweave" class="group md:pl-10">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">🔮</span>
            <h3 class="text-xl font-bold text-cyan">Workweave</h3>
          </div>
          <p class="font-mono text-[11px] text-text-muted mb-3">How you support users</p>
          <p class="text-sm leading-relaxed text-text-secondary">
            AI agents orchestrated across Salesforce, ServiceNow, and Snowflake.
            30-second resolution instead of 15-minute manual triage.
            60% fewer L1 tickets, $72k saved per 1,000 users.
          </p>
          <div class="mt-4 flex items-center gap-1 text-xs font-medium text-cyan opacity-0 transition-opacity group-hover:opacity-100">
            Learn more →
          </div>
        </a>

      </div>

      <!-- Connecting line -->
      <div class="mt-8 pt-6 border-t border-border/50 text-center">
        <p class="text-sm text-text-secondary">
          Together, they form the <strong class="text-text-primary">AI spine</strong> for
          how you build software and support users.
        </p>
      </div>
    </div>

    <!-- Datacenter — separate, different buyer -->
    <div class="mt-6" data-animate>
      <a href="/products/datacenter" class="group glow-card-subtle block p-6 md:p-8">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
          <div class="flex items-center gap-4">
            <span class="text-2xl">🏗️</span>
            <div>
              <h3 class="text-lg font-bold text-amber">Datacenter Solutions</h3>
              <p class="font-mono text-[11px] text-text-muted">ExaScale Thermal Intelligence — for data center operators</p>
            </div>
          </div>
          <div class="flex items-center gap-6">
            <div class="flex gap-4">
              <span class="text-sm font-bold text-amber">95% accuracy</span>
              <span class="text-text-muted">·</span>
              <span class="text-sm font-bold text-amber">$2-5M saved/yr</span>
              <span class="text-text-muted">·</span>
              <span class="text-sm font-bold text-amber">15% cooling cut</span>
            </div>
            <svg class="h-5 w-5 text-amber opacity-0 transition-all group-hover:opacity-100 group-hover:translate-x-1 shrink-0 hidden md:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </div>
        </div>
      </a>
    </div>

  </div>
</section>
