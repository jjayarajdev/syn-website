---
---

<section class="relative py-24" id="ai-spine">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-12" data-animate>
      <span class="font-mono text-sm text-accent">// the_ai_spine</span>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
        Three products. One AI spine.
      </h2>
      <p class="mt-4 max-w-2xl text-text-secondary">
        Each product solves a different enterprise problem. Together, they form
        the operating layer for how you build software, support users, and run
        infrastructure.
      </p>
    </div>

    <!-- Product relationship table -->
    <div class="glow-card-subtle p-8 md:p-10" data-animate>
      <div class="grid gap-6 md:gap-0 md:grid-cols-3">

        <!-- BetterSDLC -->
        <a href="/products/bettersdlc" class="group md:border-r md:border-border/50 md:pr-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">⚡</span>
            <h3 class="text-lg font-bold text-accent">BetterSDLC</h3>
          </div>
          <p class="font-mono text-[11px] text-text-muted mb-3">How you build software</p>
          <p class="text-sm leading-relaxed text-text-secondary">
            AI-guided SDLC workflows across five roles. Context threads between phases.
            Compliance audit trail for every AI-generated artifact.
          </p>
          <div class="mt-4 flex items-center gap-1 text-xs font-medium text-accent opacity-0 transition-opacity group-hover:opacity-100">
            Learn more →
          </div>
        </a>

        <!-- Workweave -->
        <a href="/products/workweave" class="group md:border-r md:border-border/50 md:px-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">🔮</span>
            <h3 class="text-lg font-bold text-cyan">Workweave</h3>
          </div>
          <p class="font-mono text-[11px] text-text-muted mb-3">How you support users</p>
          <p class="text-sm leading-relaxed text-text-secondary">
            AI agents orchestrated across Salesforce, ServiceNow, and Snowflake.
            30-second resolution instead of 15-minute manual triage.
          </p>
          <div class="mt-4 flex items-center gap-1 text-xs font-medium text-cyan opacity-0 transition-opacity group-hover:opacity-100">
            Learn more →
          </div>
        </a>

        <!-- Datacenter -->
        <a href="/products/datacenter" class="group md:pl-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">🏗️</span>
            <h3 class="text-lg font-bold text-amber">Datacenter Solutions</h3>
          </div>
          <p class="font-mono text-[11px] text-text-muted mb-3">How you run infrastructure</p>
          <p class="text-sm leading-relaxed text-text-secondary">
            AI thermal management built on exascale data. 95% prediction accuracy.
            15% cooling savings, $2-5M/year per facility.
          </p>
          <div class="mt-4 flex items-center gap-1 text-xs font-medium text-amber opacity-0 transition-opacity group-hover:opacity-100">
            Learn more →
          </div>
        </a>

      </div>

      <!-- Connecting line -->
      <div class="mt-8 pt-6 border-t border-border/50 text-center">
        <p class="text-sm text-text-secondary">
          Together, they form the <strong class="text-text-primary">AI spine</strong> for
          how you build software, support users, and run infrastructure.
        </p>
      </div>
    </div>
  </div>
</section>
