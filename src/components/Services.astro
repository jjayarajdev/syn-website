---
const services = [
  {
    title: 'Application Services',
    description: 'End-to-end application development, modernization, and managed services across enterprise platforms.',
    tags: ['Salesforce', 'Workday', 'Java', '.NET', 'MERN', 'React Native'],
    capabilities: ['Packaged App Implementation', 'Custom Full-Stack Development', 'Application Rationalization', 'Managed Services (AMS)'],
  },
  {
    title: 'Cloud Transformation',
    description: 'Strategy-led cloud migration and modernization. Public, private, and hybrid — with security and governance built in.',
    tags: ['AWS', 'Azure', 'GCP', 'Kubernetes', 'Docker', 'Terraform'],
    capabilities: ['Cloud Strategy & Roadmap', 'Re-architecting & Modernization', 'Cloud Security & Governance', 'Cloud Testing & QA'],
  },
  {
    title: 'Infrastructure Services',
    description: 'Enterprise infrastructure management, from service desk to cybersecurity operations.',
    tags: ['ITSM', 'NOC/SOC', 'CyberSec', 'UCC', 'Virtualization'],
    capabilities: ['Service Desk & Management', 'Network Ops & Optimization', 'Cyber Security Solutions', 'Data Center Services'],
  },
  {
    title: 'Data & AI',
    description: 'Full-stack data engineering and AI capabilities — from BI pipelines to production GenAI and LLM solutions.',
    tags: ['Python', 'PyTorch', 'OpenAI', 'Bedrock', 'LangChain', 'Llama'],
    capabilities: ['BI & Data Warehousing', 'ETL & Data Pipelines', 'GenAI & LLM Solutions', 'Rapid Prototyping (MVP)'],
  },
];
---

<section class="relative py-32" id="services">
  <div class="mx-auto max-w-7xl px-6">
    <!-- Section header -->
    <div class="mb-16" data-animate>
      <span class="font-mono text-sm text-accent">// service_portfolio</span>
      <h2 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
        Services
      </h2>
      <p class="mt-4 max-w-2xl text-lg text-text-secondary">
        Four pillars of deep enterprise capability. Each backed by proven
        delivery across six industry verticals.
      </p>
    </div>

    <!-- Service grid -->
    <div class="grid gap-6 md:grid-cols-2" data-stagger>
      {services.map((service) => (
        <div class="rounded-2xl border border-border bg-surface/20 p-8 transition-all card-hover">
          <h3 class="text-xl font-bold text-text-primary">{service.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary">{service.description}</p>

          <!-- Capabilities -->
          <ul class="mt-5 space-y-2">
            {service.capabilities.map((cap) => (
              <li class="flex items-center gap-2 text-sm text-text-muted">
                <svg class="h-3 w-3 shrink-0 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {cap}
              </li>
            ))}
          </ul>

          <!-- Tech tags -->
          <div class="mt-6 flex flex-wrap gap-1.5">
            {service.tags.map((tag) => (
              <span class="rounded-md bg-deep px-2 py-0.5 font-mono text-[10px] text-text-muted">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
