---
const pillars = [
  {
    title: 'Catalyst Studio',
    tagline: 'Invent it',
    description: 'Idea to working proof in 4 weeks. Our MVP factory with custom LLMs, Agentic RAG, and vision models.',
    href: '/services/catalyst-studio',
    color: 'accent',
    tags: ['4-Week Sprints', 'Domain LLMs', 'Agentic RAG', 'Vision Models'],
  },
  {
    title: 'Build & Modernize',
    tagline: 'Build it',
    description: 'Enterprise apps and cloud infrastructure. Salesforce, Workday, custom full-stack, plus AWS/Azure/GCP migration.',
    href: '/services/application-services',
    color: 'cyan',
    tags: ['Salesforce', 'Workday', 'AWS', 'Azure', 'Kubernetes'],
  },
  {
    title: 'Data & AI',
    tagline: 'Power it',
    description: 'From BI pipelines to production GenAI. The entire data stack that makes AI work at enterprise scale.',
    href: '/services/data-ai',
    color: 'accent',
    tags: ['GenAI/LLM', 'Data Pipelines', 'RAG', 'ML Models', 'MLOps'],
  },
  {
    title: 'Operate & Secure',
    tagline: 'Protect it',
    description: '24/7 NOC/SOC, cybersecurity, service desk — AI-augmented by our agent platform. We keep it running.',
    href: '/services/infrastructure',
    color: 'amber',
    tags: ['24/7 NOC/SOC', 'CyberSec', 'Service Desk', 'AI Triage'],
  },
];
---

<section class="relative py-8" id="services">
  <div class="mx-auto max-w-7xl px-6">
    <!-- Section header -->
    <div class="mb-10" data-animate>
      <span class="font-mono text-sm text-accent">// service_portfolio</span>
      <h2 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
        Four pillars.<br/>
        <span class="gradient-text">One team.</span>
      </h2>
      <p class="mt-4 max-w-2xl text-text-secondary">
        Every engagement starts in Catalyst Studio. Build, Data/AI, and Operate
        follow from a successful proof. One funnel — not four parallel offerings.
      </p>
      <p class="mt-3 max-w-2xl text-sm text-text-muted">
        Engage us the way that fits: a 4-week sprint, an end-to-end project team,
        or engineers embedded in your own team. AWS and Azure partners — we work
        in your cloud.
      </p>
    </div>

    <!-- 4 pillar cards -->
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
      {pillars.map((pillar) => (
        <a href={pillar.href} class="group glow-card-subtle p-7 flex flex-col">
          <div class="flex items-center justify-between mb-5">
            <span class="font-mono text-[11px] text-text-secondary opacity-60">{pillar.tagline}</span>
          </div>
          <h3 class={`text-lg font-bold text-${pillar.color}`}>{pillar.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary flex-1">
            {pillar.description}
          </p>
          <div class="mt-5 pt-4 border-t border-border/50 flex flex-wrap gap-1.5">
            {pillar.tags.map((tag) => (
              <span class="rounded-md bg-deep/60 px-2 py-0.5 text-[11px] text-text-secondary">{tag}</span>
            ))}
          </div>
          <div class={`mt-4 flex items-center gap-1 text-xs font-medium text-${pillar.color} opacity-0 transition-opacity group-hover:opacity-100`}>
            Explore
            <svg class="h-3 w-3 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </div>
        </a>
      ))}
    </div>

    <!-- See all link -->
    <div class="mt-8 text-center" data-animate>
      <a href="/services" class="inline-flex items-center gap-2 text-sm font-medium text-text-muted hover:text-accent transition-colors">
        See all services in detail
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
