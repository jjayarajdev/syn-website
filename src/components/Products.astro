---
import Icon from './Icon.astro';
---

<section class="relative py-8" id="products">
  <div class="mx-auto max-w-7xl px-6">
    <!-- Section header -->
    <div class="mb-10" data-animate>
      <span class="font-mono text-sm text-accent">// what_we_build</span>
      <h2 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
        We don't just consult.<br/>
        <span class="gradient-text">We build.</span>
      </h2>
      <p class="mt-4 max-w-2xl text-lg text-text-secondary">
        One team, three ways to engage: platforms we've built in-house, projects
        we deliver end to end, and engineers who join your team. It all rests on
        the same platform stack.
      </p>
    </div>

    <!-- Teaser grid — 3 columns -->
    <div class="grid gap-4 md:grid-cols-3" data-stagger>

      <!-- Contract Intelligence -->
      <a href="/products/contract-intelligence" class="group glow-card-subtle p-7 flex flex-col">
        <div class="flex items-center justify-between mb-5">
          <span class="inline-flex h-10 w-10 items-center justify-center border border-border bg-deep/30"><Icon name="file-text" size={20} class="text-accent" /></span>
          <span class="font-mono text-[12px] text-accent opacity-60">01</span>
        </div>
        <h3 class="text-xl font-bold text-accent">Contract Intelligence</h3>
        <p class="mt-1 font-mono text-[13px] text-text-muted">Contract lifecycle + relationship governance</p>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary flex-1">
          Nine AI agents for contract extraction, risk and obligations — plus the
          relationship-governance layer no legacy CLM has. Live demo available.
        </p>
        <div class="mt-5 pt-4 border-t border-border/50 flex items-center justify-between">
          <div class="flex gap-3">
            <span class="text-[13px] text-text-secondary">Multi-Tenant</span>
            <span class="text-[13px] text-text-secondary">9 Agents</span>
            <span class="text-[13px] text-text-secondary">Audit Trace</span>
          </div>
          <svg class="h-4 w-4 text-accent opacity-0 transition-all group-hover:opacity-100 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </div>
      </a>

      <!-- Business Operations -->
      <a href="/products/business-operations" class="group glow-card-subtle p-7 flex flex-col">
        <div class="flex items-center justify-between mb-5">
          <span class="inline-flex h-10 w-10 items-center justify-center border border-border bg-deep/30"><Icon name="layout-grid" size={20} class="text-accent" /></span>
          <span class="font-mono text-[12px] text-accent opacity-60">02</span>
        </div>
        <h3 class="text-xl font-bold text-accent">Business Operations</h3>
        <p class="mt-1 font-mono text-[13px] text-text-muted">AI-native, seven modules, one platform</p>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary flex-1">
          Sales, Marketing, HR, Finance, Projects, Recruitment and ITSM in one
          platform — with 160 AI actions across four autonomy levels.
        </p>
        <div class="mt-5 pt-4 border-t border-border/50 flex items-center justify-between">
          <div class="flex gap-3">
            <span class="text-[13px] text-text-secondary">7 Modules</span>
            <span class="text-[13px] text-text-secondary">AI Assistant</span>
            <span class="text-[13px] text-text-secondary">MCP</span>
          </div>
          <svg class="h-4 w-4 text-accent opacity-0 transition-all group-hover:opacity-100 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </div>
      </a>

      <!-- AI Governance -->
      <a href="/products/ai-governance" class="group glow-card-subtle p-7 flex flex-col">
        <div class="flex items-center justify-between mb-5">
          <span class="inline-flex h-10 w-10 items-center justify-center border border-border bg-deep/30"><Icon name="shield-check" size={20} class="text-accent" /></span>
          <span class="font-mono text-[12px] text-accent opacity-60">03</span>
        </div>
        <h3 class="text-xl font-bold text-accent">AI Governance</h3>
        <p class="mt-1 font-mono text-[13px] text-text-muted">Every AI call governed, logged, audited</p>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary flex-1">
          Every LLM call in your enterprise — intercepted, checked against policy,
          screened by local DLP and logged. AI adoption without losing the audit
          trail.
        </p>
        <div class="mt-5 pt-4 border-t border-border/50 flex items-center justify-between">
          <div class="flex gap-3">
            <span class="text-[13px] text-text-secondary">Local ML DLP</span>
            <span class="text-[13px] text-text-secondary">Policy</span>
            <span class="text-[13px] text-text-secondary">Full Audit</span>
          </div>
          <svg class="h-4 w-4 text-accent opacity-0 transition-all group-hover:opacity-100 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </div>
      </a>

    </div>

    <!-- See all link -->
    <div class="mt-8 text-center" data-animate>
      <a href="/products" class="inline-flex items-center gap-2 text-sm font-medium text-text-muted hover:text-accent transition-colors">
        See all platforms in detail
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
