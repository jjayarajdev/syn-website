---
---

<section class="relative py-32" id="products">
  <div class="mx-auto max-w-7xl px-6">
    <!-- Section header -->
    <div class="mb-16" data-animate>
      <span class="font-mono text-sm text-accent">// what_we_build</span>
      <h2 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
        We don't just consult.<br/>
        <span class="gradient-text">We build.</span>
      </h2>
      <p class="mt-4 max-w-2xl text-lg text-text-secondary">
        Three products. Built in-house. Shipping to production.
        Most companies our size pick one lane — we built the whole highway.
      </p>
    </div>

    <!-- Teaser grid — 3 columns -->
    <div class="grid gap-4 md:grid-cols-3" data-stagger>

      <!-- BetterSDLC -->
      <a href="/products/bettersdlc" class="group glow-card-subtle p-7 flex flex-col">
        <div class="flex items-center justify-between mb-5">
          <span class="text-3xl">⚡</span>
          <span class="font-mono text-[10px] text-accent opacity-60">01</span>
        </div>
        <h3 class="text-xl font-bold text-accent">BetterSDLC</h3>
        <p class="mt-1 font-mono text-[11px] text-text-muted">Ship better software, faster</p>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary flex-1">
          Structured AI workflows for your entire SDLC. Five roles, one thread of context,
          full compliance audit trail.
        </p>
        <div class="mt-5 pt-4 border-t border-border/50 flex items-center justify-between">
          <div class="flex gap-3">
            <span class="text-[10px] text-text-muted">VS Code</span>
            <span class="text-[10px] text-text-muted">Desktop</span>
            <span class="text-[10px] text-text-muted">MCP</span>
          </div>
          <svg class="h-4 w-4 text-accent opacity-0 transition-all group-hover:opacity-100 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </div>
      </a>

      <!-- Workweave -->
      <a href="/products/workweave" class="group glow-card-subtle p-7 flex flex-col">
        <div class="flex items-center justify-between mb-5">
          <span class="text-3xl">🔮</span>
          <span class="font-mono text-[10px] text-cyan opacity-60">02</span>
        </div>
        <h3 class="text-xl font-bold text-cyan">Workweave</h3>
        <p class="mt-1 font-mono text-[11px] text-text-muted">Agentic OS for Business</p>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary flex-1">
          AI agents that orchestrate across Salesforce, ServiceNow, and Snowflake.
          30 seconds, not 15 minutes.
        </p>
        <div class="mt-5 pt-4 border-t border-border/50 flex items-center justify-between">
          <div class="flex gap-3">
            <span class="text-[10px] text-text-muted">Multi-Agent</span>
            <span class="text-[10px] text-text-muted">RAG</span>
            <span class="text-[10px] text-text-muted">Voice</span>
          </div>
          <svg class="h-4 w-4 text-cyan opacity-0 transition-all group-hover:opacity-100 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </div>
      </a>

      <!-- Datacenter -->
      <a href="/products/datacenter" class="group glow-card-subtle p-7 flex flex-col">
        <div class="flex items-center justify-between mb-5">
          <span class="text-3xl">🏗️</span>
          <span class="font-mono text-[10px] text-amber opacity-60">03</span>
        </div>
        <h3 class="text-xl font-bold text-amber">Datacenter Solutions</h3>
        <p class="mt-1 font-mono text-[11px] text-text-muted">ExaScale Thermal Intelligence</p>
        <p class="mt-3 text-sm leading-relaxed text-text-secondary flex-1">
          AI thermal management built on real exascale data. 95% accuracy,
          15% cooling savings, $2-5M/year.
        </p>
        <div class="mt-5 pt-4 border-t border-border/50 flex items-center justify-between">
          <div class="flex gap-3">
            <span class="text-[10px] text-text-muted">Ensemble ML</span>
            <span class="text-[10px] text-text-muted">Digital Twin</span>
            <span class="text-[10px] text-text-muted">ESG</span>
          </div>
          <svg class="h-4 w-4 text-amber opacity-0 transition-all group-hover:opacity-100 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </div>
      </a>

    </div>

    <!-- See all link -->
    <div class="mt-8 text-center" data-animate>
      <a href="/products" class="inline-flex items-center gap-2 text-sm font-medium text-text-muted hover:text-accent transition-colors">
        See all products in detail
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
