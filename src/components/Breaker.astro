---
/**
 * Editorial section breaker — a hairline rule carrying three small squares
 * in the mark's colors (forest · brass · slate). Use between major sections
 * so the eye registers a chapter change.
 *
 * variant="rule"   : hairline + three squares (default)
 * variant="label"  : hairline + centered mono label (pass text via `label`)
 */
interface Props {
  variant?: 'rule' | 'label';
  label?: string;
}
const { variant = 'rule', label } = Astro.props;
---

<div class="mx-auto max-w-7xl px-6" aria-hidden="true">
  {variant === 'rule' ? (
    <div class="flex items-center gap-4 py-2">
      <span class="h-px flex-1 bg-border"></span>
      <span class="flex items-center gap-1.5">
        <span class="h-[5px] w-[5px] bg-accent"></span>
        <span class="h-[5px] w-[5px] bg-amber"></span>
        <span class="h-[5px] w-[5px] bg-cyan"></span>
      </span>
      <span class="h-px flex-1 bg-border"></span>
    </div>
  ) : (
    <div class="flex items-center gap-4 py-2">
      <span class="h-px flex-1 bg-border"></span>
      <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-text-muted">{label}</span>
      <span class="h-px flex-1 bg-border"></span>
    </div>
  )}
</div>
