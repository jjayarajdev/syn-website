---
const industries = [
  { name: 'Manufacturing' },
  { name: 'Lifesciences' },
  { name: 'Healthcare' },
  { name: 'Engineering' },
  { name: 'Insurance & Insurtech' },
  { name: 'Banking' },
];
---

<section class="relative py-12">
  <div class="mx-auto max-w-7xl px-6">
    <div class="rounded-2xl border border-border bg-surface/20 p-12" data-animate>
      <div class="text-center">
        <span class="font-mono text-sm text-accent">// industries</span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight">
          Six industries. All hard.
        </h2>
        <p class="mt-3 text-text-secondary">
          We chose regulated, complex, unglamorous industries on purpose —
          because that's where AI creates real value.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6" data-stagger>
        {industries.map((industry) => (
          <div class="flex flex-col items-center gap-3 rounded-xl border border-border/50 bg-deep/30 p-6 text-center transition-all hover:border-border-light hover:bg-elevated/30">
            <span class="text-xs font-medium text-text-secondary">{industry.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
