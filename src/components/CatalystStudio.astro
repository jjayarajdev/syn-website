---
const capabilities = [
  {
    name: 'Custom Domain LLMs',
    description: 'Tailored models for Tax, Legal, and Finance domains. Customizable, secure, and production-ready.',
    icon: '🧠',
  },
  {
    name: 'Agentic RAG',
    description: 'Home-grown accelerator for unstructured document extraction and retrieval-augmented generation.',
    icon: '🔍',
  },
  {
    name: 'Vision Models',
    description: 'YOLO-based custom models for business-specific object detection and visual intelligence.',
    icon: '👁️',
  },
  {
    name: 'Smart Prompts',
    description: 'Efficient behind-the-scenes prompting for better throughput and productivity at scale.',
    icon: '⚙️',
  },
];

const phases = [
  { num: '01', name: 'Ideation', desc: 'Stakeholder alignment & benefits identification' },
  { num: '02', name: 'Tech Stack', desc: 'Architecture finalization & developer deployment' },
  { num: '03', name: 'Rapid Build', desc: 'Accelerated prototyping with our AI toolkit' },
  { num: '04', name: 'Toll Gate', desc: 'Go / No-Go decision with production roadmap' },
];
---

<section class="relative py-32 overflow-hidden" id="catalyst">
  <!-- Background accent -->
  <div class="absolute inset-0 bg-gradient-to-b from-void via-surface/30 to-void"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-6">
    <!-- Section header -->
    <div class="mb-16" data-animate>
      <span class="font-mono text-sm text-accent">// catalyst_studio</span>
      <h2 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
        Our MVP Factory
      </h2>
      <p class="mt-4 max-w-2xl text-lg text-text-secondary">
        A proprietary accelerator platform that takes your AI idea from concept to
        working proof in 4 weeks. We de-risk innovation through rigorous feasibility
        validation before you scale.
      </p>
    </div>

    <!-- Capabilities grid -->
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-20" data-stagger>
      {capabilities.map((cap) => (
        <div class="rounded-xl border border-border bg-surface/50 p-6 backdrop-blur-sm transition-all card-hover">
          <div class="mb-4 text-3xl">{cap.icon}</div>
          <h3 class="text-sm font-semibold text-text-primary">{cap.name}</h3>
          <p class="mt-2 text-xs leading-relaxed text-text-muted">{cap.description}</p>
        </div>
      ))}
    </div>

    <!-- POT Timeline -->
    <div data-animate>
      <h3 class="mb-8 text-center text-xl font-bold text-text-primary">
        4-Week Innovation Sprint
      </h3>
      <div class="relative">
        <!-- Connection line -->
        <div class="absolute top-8 left-0 right-0 hidden h-px bg-gradient-to-r from-transparent via-accent/30 to-transparent lg:block"></div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
          {phases.map((phase) => (
            <div class="relative text-center">
              <div class="relative z-10 mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl border border-accent/20 bg-accent/5">
                <span class="font-mono text-lg font-bold text-accent">{phase.num}</span>
              </div>
              <h4 class="text-sm font-semibold text-text-primary">{phase.name}</h4>
              <p class="mt-1 text-xs text-text-muted">{phase.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
