---
const industries = [
  { name: 'Manufacturing' },
  { name: 'Lifesciences' },
  { name: 'Healthcare' },
  { name: 'Engineering' },
  { name: 'Insurance' },
  { name: 'Banking' },
];
---

<section class="relative py-12">
  <div class="mx-auto max-w-7xl px-6">

    <!-- Why bet on the small team -->
    <div class="grid gap-12 lg:grid-cols-2 lg:items-start mb-10">
      <div data-animate>
        <span class="font-mono text-sm text-accent">// why_us</span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          Why bet on the<br />
          <span class="gradient-text">lean team?</span>
        </h2>
        <p class="mt-4 text-text-secondary">
          Because we don't have layers to hide behind. No sales team making
          promises engineering can't keep. No offshore bench learning your
          codebase from scratch. Just builders who make their own products
          and answer the phone when something breaks.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-3" data-stagger>
        {[
          { stat: '8', label: 'Platforms built in-house', detail: 'Contract intelligence, business operations, AI governance, regulatory reporting and more — built and run by this team.' },
          { stat: '40+', label: 'Technologies deep', detail: 'Not resume keywords. Production deployments across six industries.' },
          { stat: '4 wks', label: 'Proof to production', detail: 'Our POT methodology turns "is this possible?" into "here\'s the proof."' },
          { stat: '1', label: 'Team. End to end.', detail: 'Strategy, AI, cloud, apps, infra — no subcontracting, no finger-pointing.' },
        ].map((d) => (
          <div class="glow-card-subtle p-5">
            <div class="text-2xl font-black text-accent">{d.stat}</div>
            <div class="mt-1 text-xs font-semibold text-text-primary">{d.label}</div>
            <div class="mt-2 text-[11px] leading-relaxed text-text-secondary">{d.detail}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Cloud partners -->
    <div class="mb-6 flex flex-wrap items-center justify-center gap-3 rounded-2xl border border-border/50 bg-deep/30 px-8 py-5" data-animate>
      <span class="text-sm font-semibold text-text-primary">Cloud partners:</span>
      <span class="rounded-full border border-border px-4 py-1.5 text-sm text-text-secondary">AWS</span>
      <span class="rounded-full border border-border px-4 py-1.5 text-sm text-text-secondary">Microsoft Azure</span>
      <span class="text-sm text-text-muted">We deploy in your cloud, under your controls — not ours.</span>
    </div>

    <!-- Industries + constraint -->
    <div class="glow-card-subtle p-10" data-animate>
      <div class="text-center mb-8">
        <h3 class="text-xl font-bold">Six industries. All hard. All regulated.</h3>
        <p class="mt-2 text-sm text-text-secondary">
          We don't do everything for everyone. We go deep on the stacks our
          six industries actually run in production.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
        {industries.map((industry) => (
          <div class="flex flex-col items-center gap-2 rounded-lg border border-border/50 bg-deep/30 p-4 text-center transition-all hover:border-border-light hover:bg-elevated/30">
            <span class="text-xs font-medium text-text-secondary">{industry.name}</span>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
