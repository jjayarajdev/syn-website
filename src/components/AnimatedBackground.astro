---
/**
 * Animated background with floating particles + gradient mesh
 * - Particles: lightweight canvas, ~60 dots drifting + faint connection lines
 * - Gradient mesh: CSS animated blobs for ambient color depth
 * - Respects prefers-reduced-motion
 * - Renders behind all content via fixed positioning
 */
---

<!-- Gradient mesh blobs (CSS only) -->
<div class="pointer-events-none fixed inset-0 z-0 overflow-hidden" aria-hidden="true">
  <div class="mesh-blob mesh-blob-1"></div>
  <div class="mesh-blob mesh-blob-2"></div>
  <div class="mesh-blob mesh-blob-3"></div>
</div>

<!-- Particle canvas -->
<canvas id="particle-canvas" class="pointer-events-none fixed inset-0 z-[1]" aria-hidden="true"></canvas>

<style>
  .mesh-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.09;
    will-change: transform;
  }

  .mesh-blob-1 {
    width: 700px;
    height: 700px;
    background: var(--color-accent);
    top: -10%;
    left: -5%;
    animation: mesh-drift-1 25s ease-in-out infinite;
  }

  .mesh-blob-2 {
    width: 600px;
    height: 600px;
    background: var(--color-cyan);
    top: 40%;
    right: -10%;
    animation: mesh-drift-2 30s ease-in-out infinite;
  }

  .mesh-blob-3 {
    width: 550px;
    height: 550px;
    background: var(--color-amber);
    bottom: -5%;
    left: 30%;
    animation: mesh-drift-3 35s ease-in-out infinite;
  }

  @keyframes mesh-drift-1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(8vw, 12vh) scale(1.1); }
    66% { transform: translate(-5vw, 5vh) scale(0.95); }
  }

  @keyframes mesh-drift-2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(-10vw, -8vh) scale(1.05); }
    66% { transform: translate(5vw, 10vh) scale(1.1); }
  }

  @keyframes mesh-drift-3 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(12vw, -5vh) scale(0.9); }
    66% { transform: translate(-8vw, -10vh) scale(1.05); }
  }

  @media (prefers-reduced-motion: reduce) {
    .mesh-blob { animation: none !important; }
    #particle-canvas { display: none !important; }
  }
</style>

<script>
  const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement;
  if (!canvas) throw new Error('Canvas not found');
  const ctx = canvas.getContext('2d')!;

  // Check reduced motion
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReduced) {
    canvas.style.display = 'none';
  }

  let width = 0;
  let height = 0;
  let particles: { x: number; y: number; vx: number; vy: number; r: number; opacity: number }[] = [];
  const PARTICLE_COUNT = 60;
  const CONNECTION_DIST = 180;
  const COLORS = ['0, 232, 123', '0, 212, 255', '255, 184, 0']; // accent, cyan, amber

  function resize() {
    width = canvas.width = window.innerWidth;
    height = canvas.height = document.documentElement.scrollHeight;
  }

  function init() {
    resize();
    particles = [];
    for (let i = 0; i < PARTICLE_COUNT; i++) {
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.3,
        vy: (Math.random() - 0.5) * 0.3,
        r: Math.random() * 2 + 0.8,
        opacity: Math.random() * 0.4 + 0.15,
      });
    }
  }

  function draw() {
    if (prefersReduced) return;

    ctx.clearRect(0, 0, width, height);

    // Draw connections
    for (let i = 0; i < particles.length; i++) {
      for (let j = i + 1; j < particles.length; j++) {
        const dx = particles[i].x - particles[j].x;
        const dy = particles[i].y - particles[j].y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < CONNECTION_DIST) {
          const opacity = (1 - dist / CONNECTION_DIST) * 0.12;
          ctx.strokeStyle = `rgba(0, 232, 123, ${opacity})`;
          ctx.lineWidth = 0.5;
          ctx.beginPath();
          ctx.moveTo(particles[i].x, particles[i].y);
          ctx.lineTo(particles[j].x, particles[j].y);
          ctx.stroke();
        }
      }
    }

    // Draw particles
    for (const p of particles) {
      const color = COLORS[Math.floor(p.r * 3) % COLORS.length];
      ctx.fillStyle = `rgba(${color}, ${p.opacity})`;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fill();

      // Move
      p.x += p.vx;
      p.y += p.vy;

      // Wrap around
      if (p.x < -10) p.x = width + 10;
      if (p.x > width + 10) p.x = -10;
      if (p.y < -10) p.y = height + 10;
      if (p.y > height + 10) p.y = -10;
    }

    requestAnimationFrame(draw);
  }

  init();
  if (!prefersReduced) draw();

  // Resize on window change (debounced)
  let resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      resize();
    }, 200);
  });
</script>
