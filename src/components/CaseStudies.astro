---
const patterns = [
  {
    tag: 'Insurance Aggregator · Middle East',
    title: 'Insurance sales → one platform, 30+ locations',
    description: 'AI-assisted sales platform for a Middle East-based insurance aggregator shopping 35+ carriers per customer. The carrier comparison moved out of agents\' heads and into the platform. In production.',
    metrics: [
      { value: 'Live', label: 'In production' },
      { value: '35+', label: 'Carriers shopped' },
      { value: '200+', label: 'Locations served' },
    ],
    replicable: 'Any multi-carrier agency, panel or aggregator sales network.',
    href: '/case-studies/insurance-sales-platform',
  },
  {
    tag: 'AI Service Desk',
    title: 'IT Support → 60% fewer tickets',
    description: 'Multi-agent system resolves L1 tickets in 2 minutes instead of 4 hours. ServiceNow + Salesforce + Knowledge Base — orchestrated by our agent platform.',
    metrics: [
      { value: '$72k', label: 'Annual savings' },
      { value: '2 min', label: 'Resolution time' },
      { value: '60%', label: 'Ticket reduction' },
    ],
    replicable: 'Any IT support org with ServiceNow and 500+ tickets/month.',
    href: '/case-studies/ai-it-support',
  },
  {
    tag: 'Field Services · US',
    title: 'Scheduling → Zero wait time',
    description: 'Omni-channel AI assistant for a US field-services platform across Voice, Chat, SMS. Weather-aware scheduling, confirm loops, full audit trail. In production on Claude via AWS Bedrock.',
    metrics: [
      { value: 'Live', label: 'In production' },
      { value: '0 min', label: 'Wait time' },
      { value: '4', label: 'Channels' },
    ],
    replicable: 'Any scheduling-heavy business with 200+ daily calls.',
    href: '/case-studies/ai-scheduling-assistant',
  },
  {
    tag: 'Home Improvement · Compliance',
    title: 'Compliance → a lookup, not a project',
    description: 'License & contractor compliance platform for one of America\'s largest home-improvement platforms — jurisdiction monitoring, AI document verification, pre-computed status. In delivery against contractual milestones.',
    metrics: [
      { value: 'Active', label: 'In delivery' },
      { value: '3-level', label: 'Jurisdictions' },
      { value: 'In SOW', label: 'AI accuracy SLA' },
    ],
    replicable: 'Any contractor-network business with multi-state compliance exposure.',
    href: '/case-studies/contractor-compliance-platform',
  },
];
---

<section class="relative py-12" id="proof">
  <div class="mx-auto max-w-7xl px-6">
    <!-- Section header -->
    <div class="mb-8 flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between" data-animate>
      <div>
        <span class="font-mono text-sm text-accent">// proof</span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          We keep receipts.
        </h2>
        <p class="mt-4 max-w-2xl text-text-secondary">
          Replicable patterns — not one-off experiments. Each started as a 4-6 week sprint.
          Each is a blueprint we can deploy at your org.
        </p>
      </div>
      <div class="shrink-0 lg:pb-1 lg:text-right">
        <div class="flex items-center gap-6 lg:justify-end">
          <div>
            <div class="text-2xl font-bold text-accent">200+</div>
            <div class="text-xs text-text-muted">Locations served</div>
          </div>
          <div class="h-10 w-px bg-border"></div>
          <div>
            <div class="text-2xl font-bold text-accent">60%</div>
            <div class="text-xs text-text-muted">Ticket reduction</div>
          </div>
          <div class="h-10 w-px bg-border"></div>
          <div>
            <div class="text-2xl font-bold text-accent">2 min</div>
            <div class="text-xs text-text-muted">L1 resolution</div>
          </div>
        </div>
        <a href="/case-studies" class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-text-secondary transition-colors hover:text-text-primary">
          All case studies
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Pattern cards -->
    <div class="grid gap-6 md:grid-cols-2" data-stagger>
      {patterns.map((pattern) => (
        <a href={pattern.href} class="group glow-card-subtle p-8">
          <!-- Tag -->
          <span class="inline-block rounded-full border border-accent/20 bg-accent/5 px-3 py-1 text-xs font-medium text-accent">
            {pattern.tag}
          </span>

          <!-- Title & Description -->
          <h3 class="mt-4 text-xl font-bold text-text-primary">{pattern.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary">{pattern.description}</p>

          <!-- Metrics -->
          <div class="mt-6 grid grid-cols-3 gap-3">
            {pattern.metrics.map((metric) => (
              <div class="rounded-lg border border-border/50 bg-deep/50 p-3 text-center">
                <div class="text-lg font-bold text-accent">{metric.value}</div>
                <div class="text-[13px] text-text-secondary">{metric.label}</div>
              </div>
            ))}
          </div>

          <!-- Replicable pattern callout -->
          <div class="mt-5 rounded-lg bg-accent/5 border border-accent/10 px-4 py-3">
            <span class="text-[13px] font-semibold text-accent">Replicable at your org →</span>
            <span class="text-[13px] text-text-secondary ml-1">{pattern.replicable}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
