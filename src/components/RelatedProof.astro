---
/**
 * Cross-link card used on platform and case-study pages so neither is a dead end.
 * Platform pages point at the case study that shows the pattern in production;
 * case-study pages point back at the platform that packages it.
 */
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  href: string;
  linkLabel: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const { eyebrow, title, description, href, linkLabel, secondaryHref, secondaryLabel } = Astro.props;
---

<section class="py-8">
  <div class="mx-auto max-w-7xl px-6">
    <div class="rounded-2xl border border-border bg-surface/20 p-8" data-animate>
      <span class="font-mono text-sm text-accent">{eyebrow}</span>
      <h3 class="mt-3 text-lg font-bold text-text-primary">{title}</h3>
      <p class="mt-3 max-w-2xl text-sm text-text-secondary">{description}</p>
      <div class="mt-4 flex flex-wrap items-center gap-x-8 gap-y-3">
        <a href={href} class="inline-flex items-center gap-1 text-sm font-medium text-accent transition-colors hover:text-accent-glow">
          {linkLabel}
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        {secondaryHref && (
          <a href={secondaryHref} class="text-sm text-text-muted transition-colors hover:text-text-secondary">
            {secondaryLabel}
          </a>
        )}
      </div>
    </div>
  </div>
</section>
