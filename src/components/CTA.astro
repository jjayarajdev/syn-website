---
---

<section class="relative py-8">
  <div class="mx-auto max-w-7xl px-6">
    <div class="relative overflow-hidden rounded-3xl border border-accent/20 bg-gradient-to-br from-accent/5 via-surface to-cyan/5 p-12 sm:p-16" data-animate>
      <!-- Background glow -->
      <div class="absolute -top-24 -right-24 h-64 w-64 rounded-full bg-accent/10 blur-[100px]"></div>
      <div class="absolute -bottom-24 -left-24 h-64 w-64 rounded-full bg-cyan/10 blur-[100px]"></div>

      <div class="relative z-10 text-center">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
          We're small enough to care.<br />
          <span class="gradient-text">Skilled enough to deliver.</span>
        </h2>
        <p class="mx-auto mt-6 max-w-xl text-lg text-text-secondary">
          No 30-page proposals. No committee approvals. Give us 4 weeks and a
          hard problem — we'll give you a working proof with real numbers.
        </p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <a
            href="/contact"
            class="group inline-flex items-center gap-2 rounded-xl bg-accent px-8 py-4 text-base font-semibold text-void transition-all hover:bg-accent-glow hover:shadow-[0_0_30px_rgba(0,232,123,0.3)]"
          >
            Book a 4-Week Sprint
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 rounded-xl border border-border px-8 py-4 text-base font-medium text-text-secondary transition-all hover:border-border-light hover:bg-elevated hover:text-text-primary"
          >
            Talk to Our Team
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
