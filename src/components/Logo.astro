---
import logoWhite from '../assets/syntegreti-logo-editorial.png';

interface Props {
  size?: 'sm' | 'md' | 'lg';
  showText?: boolean;
  glow?: boolean;
}

const { size = 'md', glow = false } = Astro.props;

const heights: Record<string, number> = {
  sm: 42,
  md: 56,
  lg: 80,
};
const h = heights[size];
const w = Math.round(h * (logoWhite.width / logoWhite.height));
---

<div class="inline-flex items-center">
  <img
    src={logoWhite.src}
    alt="Syntegreti"
    height={h}
    width={w}
  />
</div>
