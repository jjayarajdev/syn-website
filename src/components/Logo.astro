---
import mark from '../assets/syntegreti-mark-editorial.svg';

interface Props {
  size?: 'sm' | 'md' | 'lg';
  showText?: boolean;
  glow?: boolean;
}

const { size = 'md' } = Astro.props;

const fontSizes: Record<string, number> = {
  sm: 26,
  md: 34,
  lg: 48,
};
const fs = fontSizes[size];
---

<!-- Option F — tight interlock: the mark IS the S, leaning into the y -->
<span
  class="inline-flex items-baseline whitespace-nowrap font-bold text-text-primary"
  style={`font-size: ${fs}px; letter-spacing: -0.025em;`}
>
  <img
    src={mark.src}
    alt="S"
    height={mark.height}
    width={mark.width}
    class="inline-block"
    style="height: 0.88em; width: auto; transform: translateY(0.05em); margin-right: -0.06em;"
  />yntegreti</span>
