---
import { Image } from 'astro:assets';
import logoWhite from '../assets/syntegreti-logo-white.png';

interface Props {
  size?: 'sm' | 'md' | 'lg';
  showText?: boolean;
  glow?: boolean;
}

const { size = 'md', glow = false } = Astro.props;

const heights: Record<string, number> = {
  sm: 70,
  md: 92,
  lg: 127,
};
const h = heights[size];
---

<div class="inline-flex items-center">
  <Image
    src={logoWhite}
    alt="Syntegreti"
    height={h}
    width={h * (logoWhite.width / logoWhite.height)}
    densities={[1, 2]}
    class={glow ? 'drop-shadow-[0_0_16px_rgba(0,232,123,0.35)]' : ''}
  />
</div>
