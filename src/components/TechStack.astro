---
const techCategories = [
  {
    label: 'AI / ML',
    color: 'accent',
    techs: ['Python', 'PyTorch', 'Keras', 'TensorFlow', 'OpenAI', 'Claude', 'AWS Bedrock', 'Llama', 'Falcon', 'LangChain', 'MLflow', 'DSPy'],
  },
  {
    label: 'Cloud',
    color: 'cyan',
    techs: ['AWS', 'Azure', 'GCP', 'Kubernetes', 'Docker', 'Terraform'],
  },
  {
    label: 'Development',
    color: 'accent',
    techs: ['Java', '.NET', 'React', 'Node.js', 'React Native', 'TypeScript'],
  },
  {
    label: 'Enterprise',
    color: 'amber',
    techs: ['Salesforce', 'Workday', 'ServiceNow', 'ITSM'],
  },
];

const differentiators = [
  {
    stat: '8',
    label: 'Platforms shipped',
    detail: 'SDLC, agents, governance, datacenter and more — built in-house, battle-tested.',
  },
  {
    stat: '40+',
    label: 'Technologies deep',
    detail: 'Not resume keywords. Production deployments across six industries.',
  },
  {
    stat: '4 wks',
    label: 'Proof to production',
    detail: 'Our POT methodology turns "is this possible?" into "here\'s the proof."',
  },
  {
    stat: '1',
    label: 'Team. End to end.',
    detail: 'Strategy, AI, cloud, apps, infra — no subcontracting, no finger-pointing.',
  },
];
---

<section class="relative py-12 overflow-hidden">
  <div class="mx-auto max-w-7xl px-6">

    <!-- Why section with attitude -->
    <div class="mb-8" data-animate>
      <div class="grid gap-12 lg:grid-cols-2 lg:items-end">
        <div>
          <span class="font-mono text-sm text-accent">// why_us</span>
          <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Why bet on the<br />
            <span class="gradient-text">lean team?</span>
          </h2>
          <p class="mt-4 text-text-secondary">
            Because we don't have layers to hide behind. No sales team making
            promises engineering can't keep. No offshore bench learning your
            codebase from scratch. Just builders who make their own products,
            deliver enterprise services, and answer the phone when something breaks.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-3">
          {differentiators.map((d) => (
            <div class="rounded-xl border border-border bg-surface/30 p-5">
              <div class="text-2xl font-black text-accent">{d.stat}</div>
              <div class="mt-1 text-xs font-semibold text-text-primary">{d.label}</div>
              <div class="mt-2 text-[11px] leading-relaxed text-text-muted">{d.detail}</div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Tech stack - streamlined -->
    <div class="rounded-2xl border border-border bg-surface/10 p-8" data-animate>
      <div class="text-center mb-8">
        <span class="font-mono text-sm text-accent">// tech_ecosystem</span>
        <h3 class="mt-2 text-xl font-bold">Technology We Command</h3>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {techCategories.map((category) => (
          <div>
            <span class={`mb-3 block text-xs font-semibold uppercase tracking-wider text-${category.color}`}>
              {category.label}
            </span>
            <div class="flex flex-wrap gap-1.5">
              {category.techs.map((tech) => (
                <span class={`rounded-md border border-border bg-deep px-2.5 py-1 font-mono text-xs text-text-secondary transition-colors hover:border-${category.color}/30 hover:text-${category.color}`}>
                  {tech}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
