{
	"compatibility_date": "2026-03-12",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "syn-website",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"routes": [
		{ "pattern": "syntegreti.com", "custom_domain": true },
		{ "pattern": "www.syntegreti.com", "custom_domain": true }
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "syn-website-contact",
			"database_id": "a6ac84ce-9cb7-4031-98e6-496805bd70a6"
		}
	],
	"observability": {
		"enabled": true
	}
}